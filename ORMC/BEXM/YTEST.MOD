MODULE bexmYtest;         (* MT, 01.10.2024 *)(* small graphic library ------------------ *)(* фигура-рамка *)IMPORT asmlGdraw, asmlGview,       asmlYport, asmlGdsvg,       asmlSview, bexmShare;TYPE   smlVIEW  = asmlGview.smlVIEW;   svCOLOR* = POINTER TO RECORD(   smlVIEW   )      spos : INTEGER;      xpos : INTEGER;      ypos : INTEGER;      srgb : INTEGER;      flag : INTEGER;   END;   svSLIDE* = POINTER TO RECORD(   smlVIEW   )      spos : INTEGER;   END;   svSICON* = POINTER TO RECORD(   smlVIEW   )      icon* : ADDRESS;   END;   svSLOGO* = POINTER TO RECORD(   smlVIEW   )   END;VAR main : asmlYport.smlMAIN;    butt : asmlSview.svTBUTT;    linf : asmlSview.svLABEL;    logo : svSLOGO;    lamp : svSICON;    icon : svSICON;    slid : svSLIDE;    colo : svCOLOR;(* svCOLOR *)PROCEDURE hex(int : INTEGER;                VAR s : ARRAY OF SCHR);   CONST b = BIT(0FH);   VAR d : ARRAY 24 OF SCHR;BEGIN   d  := '0123456789ABCDEF';   s[6] := 0X;   s[5] := d[ORD(BIT(    int     )*b)];   s[4] := d[ORD(BIT(LSH(int,-04))*b)];   s[3] := d[ORD(BIT(LSH(int,-08))*b)];   s[2] := d[ORD(BIT(LSH(int,-12))*b)];   s[1] := d[ORD(BIT(LSH(int,-16))*b)];   s[0] := d[ORD(BIT(LSH(int,-20))*b)];END hex;PROCEDURE hsv(rgb : INTEGER) : INTEGER;   VAR r,g,b, h,s,v : INTEGER;BEGIN   r := LSH(rgb,-16) MOD 256;   g := LSH(rgb, -8) MOD 256;   b := rgb MOD 256;   v := MAX(MAX(r, g), b   );   s := MIN(MIN(r, g), b   );   h := v - s;   s := 255*h DIV MAX( v,1 );   h := MAX(h, 1 );   IF v = g THEN h := 60 * (            b-r) DIV h + 120   EI v = b THEN h := 60 * (            r-g) DIV h + 240   EI v = r THEN h := 60 * (            g-b) DIV h   END;   h := h + 360 * ORD(h < 0);   RETURN LSH(h, 16) + LSH(s, 8) + vEND hsv;PROCEDURE rgb(hsv : INTEGER) : INTEGER;   VAR i,h,s,v,r,g,b : INTEGER;BEGIN   h := LSH(hsv,-16) MOD 360;   s := LSH(hsv, -8) MOD 256;   v := hsv MOD 256;   i := h DIV 60 MOD  6 ;   h := h MOD 60;   s := v * (255 -s) DIV 256;   h := h * ( v  -s) DIV 060;   CASE i OF      0 :  r := v      ;           g := s +  h ;           b := s      |      1 :  r := v -  h ;           g := v      ;           b := s      |      2 :  r := s      ;           g := v      ;           b := s +  h |      3 :  r := s      ;           g := v -  h ;           b := v      |      4 :  r := s +  h ;           g := s      ;           b := v      |      5 :  r := v      ;           g := s      ;           b := v -  h ;   END;   r := MIN(MAX(r, 0 ), 255);   g := MIN(MAX(g, 0 ), 255);   b := MIN(MAX(b, 0 ), 255);   RETURN LSH(r, 16) + LSH(g, 8) + bEND rgb;PROCEDURE (xS : svCOLOR) InitView*();BEGIN   xS.smx1 := 158;   xS.smx2 := 128;   xS.ecol := 440080D0H;   xS.back := 00FFFFFFH;END InitView;PROCEDURE (xS : svCOLOR) DrawProc*();   VAR i,c, h : INTEGER;       j,p, w : INTEGER;BEGIN   w := xS.gmx1 - xS.gmn1      - xS.edge - xS.edge + 1 ;   h := xS.gmx2 - xS.gmn2      - xS.edge - xS.edge      - xS.head - xS.foot + 1 ;   w := w - 30;   (* рисуем радугу  *)   FOR j := 0 TO h-1 DO   p := LSH(j * 360 DIV h, 16);   c := rgb( p          + LSH(255, 8) + 255);   asmlGdraw.HorzLine(xS.gmx1                    - xS.edge - 20 ,                      xS.gmn2                    + xS.edge + j  ,                      xS.gmx1                    - xS.edge,  c  );   END;   (* рисуем оттенок *)   p := LSH(xS.spos * 360 DIV h, 16);   FOR j := h-1 DT 0 DO   FOR i := 0 TO w-1 DO   c := rgb( p        + LSH(i * 255 DIV w,8)            + j * 255 DIV h  );   asmlGdraw.DrawPlot(xS.gmn1                    + xS.edge + i,                    + xS.gmx2                    - xS.edge - j,                                c  );   END;   END;   (* выбран оттенок *)   xS.srgb := rgb(LSH(xS.xpos * 255 DIV w, 8)            + p + (h-xS.ypos) * 255 DIV h   );   hex(xS.srgb, xS.hint     );   (* рисуем бегунок *)   asmlGdraw.DrawRect(xS.gmx1 - xS.edge - 20,                      xS.gmn2 + xS.edge                              + xS.spos - 1,                      xS.gmx1 - xS.edge,                      xS.gmn2 + xS.edge                              + xS.spos + 1,                                   00FFFFFFH);   (* рисуем бегунок *)   asmlGdraw.DrawRect(xS.gmn1 + xS.edge                              + xS.xpos - 1,                      xS.gmn2 + xS.edge                              + xS.ypos - 1,                      xS.gmn1 + xS.edge                              + xS.xpos + 2,                      xS.gmn2 + xS.edge                              + xS.ypos + 2,                                   00FFFFFFH);END DrawProc;PROCEDURE (xS : svCOLOR) LbutDown*(key : BSET;                             x1,x2 : INTEGER);BEGIN   xS.flag := ORD(x1 > xS.gmx1 - xS.gmn1 -20)        + 2 * ORD(x1 < xS.gmx1 - xS.gmn1 -30);   IF xS.flag # 0              THEN xS.MousMove(key,x1,x2) END;END LbutDown;PROCEDURE (xS : svCOLOR) MousMove*(key : BSET;                             x1,x2 : INTEGER);BEGIN   IF ~xS.down    THEN RETURN             END;   x1 := MAX(MIN(x1, xS.gmx1 - xS.gmn1 - 30                   - xS.edge - xS.edge),  0 );   x2 := MAX(MIN(x2, xS.gmx2 - xS.gmn2                   - xS.head - xS.foot                   - xS.edge - xS.edge),  0 );   IF xS.flag = 1 THEN xS.spos := x2;   EI xS.flag = 2 THEN xS.xpos := x1;                       xS.ypos := x2      END;   xS.DrawView(             xS.gmn1,xS.gmn2,xS.gmx1,xS.gmx2);   IF xS.proc # NIL THEN                    xS.proc(xS, xS.srgb ) END;END MousMove;PROCEDURE (xS : svCOLOR) SendMess*(msg : BSET;                             param : INTEGER);BEGIN     param := hsv(param            );   xS.spos := LSH(param,-16) MOD 360;   xS.xpos := LSH(param, -8) MOD 256;   xS.ypos := 255-param MOD 256;     param := xS.gmx1 - xS.gmn1            - xS.edge - xS.edge;   xS.xpos := xS.xpos * param DIV 256;     param := xS.gmx2 - xS.gmn2            - xS.edge - xS.edge;   xS.ypos := xS.ypos * param DIV 256;   xS.spos := xS.spos * param DIV 360;   xS.DrawView(             xS.gmn1,xS.gmn2,xS.gmx1,xS.gmx2);END SendMess;(* svSLIDE *)PROCEDURE (xS : svSLIDE) InitView*();BEGIN   xS.smx1 := 158;   xS.smx2 := 020;   xS.fcol := 9900D080H;   xS.ecol := 99D08000H;   xS.back := 00DCDCD0H;END InitView;PROCEDURE (xS : svSLIDE) DrawProc*();BEGIN   (* рисуем процент *)   asmlGdraw.FillRect(xS.gmn1 + xS.edge,                      xS.gmn2 + xS.edge,                      xS.gmn1 + xS.edge                              + xS.spos,                      xS.gmx2 - xS.edge,                                   xS.ecol  );   (* рисуем бегунок *)   asmlGdraw.FillRect(xS.gmn1 + xS.edge                              + xS.spos - 5,                      xS.gmn2 + xS.edge,                      xS.gmn1 + xS.edge                              + xS.spos + 5,                      xS.gmx2 - xS.edge,                                   xS.fcol  );END DrawProc;PROCEDURE (xS : svSLIDE) LbutDown*(key : BSET;                             x1,x2 : INTEGER);BEGIN   x1 := MAX(MIN(x1, xS.gmx1 - xS.gmn1                   - xS.edge - xS.edge),  0 );   xS.spos := x1;   xS.DrawView(             xS.gmn1,xS.gmn2,xS.gmx1,xS.gmx2);   x1 := xS.gmx1 - xS.gmn1 - xS.edge-xS.edge ;   x1 := xS.spos * 100 DIV MAX(  x1,  1);   IF xS.proc # NIL THEN xS.proc(xS, x1)  END;END LbutDown;PROCEDURE (xS : svSLIDE) MousMove*(key : BSET;                             x1,x2 : INTEGER);BEGIN   IF xS.down THEN xS.LbutDown(key,x1,x2) END;END MousMove;(* svSICON *)PROCEDURE (xS : svSICON) InitView*();BEGIN   xS.fcol := 000702000H;   xS.back := 0FF000000H;END InitView;PROCEDURE (xS : svSICON) DrawProc*();BEGIN   asmlGdsvg.FillSsaa(                     xS.gmn1,xS.gmn2,                     xS.gmx1,xS.gmx2,//          xS.fcol, asmlGdsvg.chrA);            xS.fcol, asmlGdsvg.lamp);END DrawProc;(* svSLOGO*)PROCEDURE (xS : svSLOGO) InitView*();BEGIN   xS.fcol := 000C0FFC0H;   xS.back := 0FF000000H;END InitView;PROCEDURE (xS : svSLOGO) DrawProc*();   VAR w, h, d, i, a, r,g,b, c1,c2 : INTEGER ;                   cl,x1,x2, y1,y2 : INTEGER ;BEGIN   a := ORD(BIT(xS.fcol) * BIT(0FF000000H)  );   r := ORD(BIT(xS.fcol) * BIT(000FF0000H)  );   g := ORD(BIT(xS.fcol) * BIT(00000FF00H)  );   b := ORD(BIT(xS.fcol) * BIT(0000000FFH)  );   w := xS.gmx1-xS.edge - xS.gmn1-xS.edge + 1;   h := xS.gmx2-xS.edge - xS.gmn2-xS.edge + 1;   d := MIN(w,h) DIV 5;   c1 := a + ORD(BIT(LSH(r * 0F8H, -8))                     * BIT(000FF0000H))           + ORD(BIT(LSH(g * 0F8H, -8))                     * BIT(00000FF00H))           + ORD(BIT(LSH(b * 0F8H, -8))     );   c2 := a + ORD(BIT(LSH(r * 0F0H, -8))                     * BIT(000FF0000H))           + ORD(BIT(LSH(g * 0F0H, -8))                     * BIT(00000FF00H))           + ORD(BIT(LSH(b * 0F0H, -8))     );   x1 := xS.gmn1 + xS.edge;   y1 := xS.gmx1 - xS.edge;   x2 := xS.gmn2 + xS.edge;   y2 := xS.gmx2 - xS.edge;   cl := xS.fcol;   FOR i := 0 TO d - 1 DO       asmlGdraw.VertLine(x1+i,x2+d-i,y2, cl);       asmlGdraw.VertLine(y1-i,x2,y2-d+i, c1);       asmlGdraw.VertLine(                        y1-d-i,x2+d+i,y2, cl);       asmlGdraw.VertLine(                        x1+d+i,x2,y2-d-i, c1);       asmlGdraw.HorzLine(                        x1+d,y2-i,y1-d-d, cl);       asmlGdraw.HorzLine(                        x1+d+d,x2+i,y1-d, c1);       asmlGdraw.HorzLine(                    x1+d+d,x2+d+i,y1-d-i, c2);       asmlGdraw.HorzLine(                    x1+d+i,y2-d-i,y1-d-d, c2);   END;END DrawProc;PROCEDURE clic();   VAR res : INTEGER;BEGIN   res := bexmShare.ShowDman(main,50,50,200,100);   CASE res OF      0 : linf.text := 'ESC'|      1 : linf.text := 'YES'|      2 : linf.text := 'NOT';   END;   linf.hide := TRUE;   linf.ShowView(  );END clic;BEGIN   (* инит приложения  *)   main :=   asmlYport.InitMain(  );   main.hstr :=          'Oberon-2M ORM';   main.hint :=           'главное окно';   NEW(logo);   logo.InitSize( 10, 10 ,                  87, 87);   main.PushApex(logo);   NEW(lamp);   lamp.InitSize(132, 10 ,                 219, 87);   lamp.anch := {1, 3   };   main.PushApex(lamp);   NEW(icon);   icon.InitSize( 20,110 ,                  42,132);   main.PushApex(icon);   NEW(slid);   slid.InitSize( 50,120 ,                 209,126);   slid.anch := {1, 3   };   main.PushApex(slid);   NEW(colo);   colo.InitSize( 10,150 ,                 209,309);   colo.anch := {1,2,3,4};   colo.hint :=            'Выбор цвета';   main.PushApex(colo);   colo.SendMess({},               logo.fcol);   NEW(butt);   butt.InitSize(230,284 ,                 255,309);   butt.anch := {3,4    };   butt.text := 'YN'     ;   butt.hint := 'yes no' ;   butt.back := 00EAFAE8H;   butt.clic := clic  ;   main.PushLast(butt);   NEW(linf);   linf.InitSize(260,284 ,                 285,309);   linf.anch := {3,4    };   linf.text := 95X;   main.PushLast(linf   );   (* цикл приложения  *)   asmlYport.ShowMain(                    main);   asmlYport.MainLoop(  );END bexmYtest.