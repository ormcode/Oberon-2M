MODULE bexmE_xcb;(* тестовая лаборатория чистого xcb X11 *)IMPORT Lib := asmlXlibc,       XCB := asmlXlxcb,       XKB := asmlXlxkb,       DLL := asmlXlibd;VAR connect : ADDRESS;    setup_t : XCB.xcb_setup_iterator_t;    xscreen : XCB.xcb_screen_iterator_t;    xwindow : INTEGER;    context : INTEGER;    fcursor : INTEGER;    icursor : INTEGER;    jcursor : INTEGER;    vl_mask : INTEGER;    gc_mask : INTEGER;    cr_mask : INTEGER;    stop    : INTEGER;    vl_list : ARRAY 32 OF INTEGER;    gc_list : ARRAY 32 OF INTEGER;    cr_list : ARRAY 32 OF INTEGER;    image : POINTER TO ARRAY OF                       ARRAY OF INTEGER;   event : XCB.xcb_any_event_iterator_t;   kvent : XCB.xcb_key_event_iterator_t;   mvent : XCB.xcb_but_event_iterator_t;   exent : XCB.xcb_exp_event_iterator_t;   i,j : INTEGER;VAR xkbcont : ADDRESS;    xkbkmap : ADDRESS;    xkbstat : ADDRESS;    dxcbimg : ADDRESS;    crtpixm : ADDRESS;    dxkbx11 : ADDRESS;    x11sext : ADDRESS;    x11core : ADDRESS;    x11kmap : ADDRESS;    x11stat : ADDRESS;    xdevice : INTEGER;    depress : INTEGER;    latched : INTEGER;    xlocked : INTEGER;    xlayout : INTEGER;    keychar : INTEGER;    utfchar : INTEGER;   xkb_x11_sext : PROCEDURE@(     c : ADDRESS;                  major_xkb_version : INTEGER;                  minor_xkb_version : INTEGER;                              flags : INTEGER;              major_xkb_version_out : ADDRESS;              minor_xkb_version_out : ADDRESS;                     base_event_out : ADDRESS;                     base_error_out : ADDRESS) : INTEGER;   xkb_x11_core : PROCEDURE@(     c : ADDRESS) : INTEGER;   xkb_x11_kmap : PROCEDURE@(context: ADDRESS;                                  c : ADDRESS;                          device_id : INTEGER;                              flags : INTEGER) : ADDRESS;   xkb_x11_stat : PROCEDURE@(keymap : ADDRESS;                                  c : ADDRESS;                          device_id : INTEGER) : ADDRESS;   xcb_c_pixmap : PROCEDURE@(     c : ADDRESS;                                  d : INTEGER;                               data : ADDRESS;                              width : INTEGER;                             height : INTEGER;                              depth : INTEGER;                                 fg : INTEGER;                                 bg : INTEGER;                                gcp : ADDRESS) : INTEGER;    dxcbx11 : ADDRESS;    fdepths : ADDRESS;    ldepths : ADDRESS;    depnext : ADDRESS;    lvisual : ADDRESS;    fvisual : ADDRESS;    visnext : ADDRESS;   xcb_f_depths : PROCEDURE@(screen : ADDRESS) : ADDRESS;   xcb_d_length : PROCEDURE@(screen : ADDRESS) : INTEGER;   xcb_dep_next : PROCEDURE@( depth : ADDRESS) ;   xcb_v_length : PROCEDURE@( depth : ADDRESS) : INTEGER;   xcb_f_visual : PROCEDURE@( depth : ADDRESS) : ADDRESS;   xcb_vis_next : PROCEDURE@(visual : ADDRESS) ;   PROCEDURE IntToStr*(int : INTEGER;                                VAR str : ARRAY OF SCHR);      VAR i,p : INTEGER;   BEGIN      IF int = 0 THEN str := '0';   RETURN   END;      i := 0; p := 1000000000;      IF int < 0 THEN int := -int; str[0] := '-'; i := 1;      END;      WHILE (p #0) & (int DIV p =0) DO p := p DIV 10 END;      REPEAT str[i] := VAL( SCHR, ORD('0') + int DIV p );             int := int MOD p; p := p DIV 10; INC(  i  );      UNTIL  p = 0;      str[i] := 0X;   END IntToStr;   PROCEDURE putsINFO*(par : INTEGER;                                    inf : ARRAY OF SCHR);      VAR str : ARRAY 256 OF SCHR;   BEGIN      IntToStr(par, str); str := inf$ + str$;                                          Lib.puts(@str);   END putsINFO;   PROCEDURE rgb_visual*( );      VAR d,v : ADDRESS;          l,c : INTEGER;          i,j : INTEGER;          dep : XCB.xcb_depth_iterator_t;          vis : XCB.xcb_visualtype_iterator_t;   BEGIN      (* load libxcb.so.1 ---------------------------- *)   dxcbx11 := DLL.dlopen(                    @'libxcb-image.so.0', DLL.RTLD_LAZY);   fdepths := DLL.dlsym(dxcbx11,                  @'xcb_screen_allowed_depths_iterator');   ldepths := DLL.dlsym(dxcbx11,                    @'xcb_screen_allowed_depths_length');   depnext := DLL.dlsym(dxcbx11, @'xcb_depth_next'     );   lvisual := DLL.dlsym(dxcbx11,                            @'xcb_depth_visuals_length');   fvisual := DLL.dlsym(dxcbx11, @'xcb_depth_visuals'  );   visnext := DLL.dlsym(dxcbx11, @'xcb_visualtype_next');   PUT(@xcb_f_depths, @fdepths);   PUT(@xcb_d_length, @ldepths);   PUT(@xcb_dep_next, @depnext);   PUT(@xcb_v_length, @lvisual);   PUT(@xcb_f_visual, @fvisual);   PUT(@xcb_vis_next, @visnext);   d := xcb_f_depths(VAL(ADDRESS, xscreen) );   l := xcb_d_length(VAL(ADDRESS, xscreen) );   putsINFO(l, 'xcb_dep_length = ');   FOR i := 0 TO l-1 DO       dep := VAL(XCB.xcb_depth_iterator_t, d);       c := xcb_v_length(d);       v := xcb_f_visual(d);       putsINFO(dep.depth, 'xcb_depth = ');       putsINFO(c, '   xcb_vis_length = ');       FOR j := 0 TO c-1 DO           vis := VAL(XCB.xcb_visualtype_iterator_t, v);           putsINFO(vis.visual_id, '   visual_id = ');           putsINFO(vis.blue_mask, '      blue_mask = ');           xcb_vis_next(@v);       END;       xcb_dep_next(@d);   END;   END rgb_visual;   PROCEDURE mycursor (x,y, w,h : INTEGER ;                       cs : ARRAY OF SCHR ) : INTEGER;      VAR s,m, c,  i, n,p :  INTEGER;          src,msk : ARRAY 32 OF BSET;   BEGIN   (* load libxcb-image.so.0 ------------------------- *)   dxcbimg := DLL.dlopen(                    @'libxcb-image.so.0', DLL.RTLD_LAZY);   crtpixm := DLL.dlsym(dxcbimg,                  @'xcb_create_pixmap_from_bitmap_data');   PUT(@xcb_c_pixmap, @crtpixm);      FOR i := 0 TO 31     DO          src[i] := {}; msk[i] := {}              END;      FOR i := 0 TO w*h -1 DO          n := i DIV 32;          p := i MOD 32;          IF cs[i] = '*' THEN ICL(src[n], p)      END;          IF cs[i] # ' ' THEN ICL(msk[n], p)  END END;      c := XCB.xcb_generate_id(connect);s := xcb_c_pixmap(connect, xscreen.root, @src, w, h, 1, 0, 0, 0);m := xcb_c_pixmap(connect, xscreen.root, @msk, w, h, 1, 0, 0, 0);(*      s := XCB.xcb_generate_id(connect);      m := XCB.xcb_generate_id(connect);      XCB.xcb_create_pixmap(connect,                             1, s, xscreen.root, w,h);      XCB.xcb_create_pixmap(connect,                             1, m, xscreen.root, w,h);      XCB.xcb_put_image(connect,                 XCB.XCB_IMAGE_FORMAT_XY_BITMAP,                 s, context, w,h, 0,0,0, 1, w*h DIV 8,                 @src );      XCB.xcb_put_image(connect,                 XCB.XCB_IMAGE_FORMAT_XY_BITMAP,                 m, context, w,h, 0,0,0, 1, w*h DIV 8,                 @msk );*)      XCB.xcb_create_cursor(connect, c,                 s, m, 0H,0H,0H, 0DD00H,0FFFFH,0FFFFH,                 x, y );      XCB.xcb_flush(connect);      XCB.xcb_free_pixmap(connect, s);      XCB.xcb_free_pixmap(connect, m);      dxcbimg := DLL.dlclose(dxcbimg);      RETURN c ;   END mycursor;BEGIN   Lib.puts(@'begin module XCB');   // подключение к X-серверу   connect := XCB.xcb_connect(NIL, 0);   IF XCB.xcb_connection_has_error(connect) # 0 THEN      Lib.puts(@'error connect XCB');   END;   // доступ к экрану   setup_t := XCB.xcb_get_setup(connect);   xscreen := XCB.xcb_setup_roots_iterator(setup_t);   putsINFO(xscreen.width_in_pixels, 'screen_w = ');   putsINFO(xscreen.height_in_pixels, 'screen_h = ');// чтение visual// rgb_visual();   // создание и отображение окна   xwindow := XCB.xcb_generate_id(connect);   vl_mask := XCB.XCB_CW_BACK_PIXEL            + XCB.XCB_CW_EVENT_MASK;   vl_list[0] := xscreen.white_pixel;   vl_list[1] := XCB.XCB_EVENT_MASK_KEY_PRESS               + XCB.XCB_EVENT_MASK_BUTTON_PRESS               + XCB.XCB_EVENT_MASK_EXPOSURE;   XCB.xcb_create_window(connect, 24, xwindow,                               xscreen.root, 0,0, 500, 300, 1,                               XCB.XCB_WINDOW_CLASS_INPUT_OUTPUT,                               xscreen.root_visual,                               vl_mask,                               vl_list);   // установка заголовка и иконки   XCB.xcb_change_property(connect,                                 XCB.XCB_PROP_MODE_REPLACE,                                 xwindow,                                 XCB.XCB_ATOM_WM_NAME,                                 XCB.XCB_ATOM_STRING,                                 8, 16, @'Test xcb ormcode');   XCB.xcb_change_property(connect,                                 XCB.XCB_PROP_MODE_REPLACE,                                 xwindow,                                 XCB.XCB_ATOM_WM_ICON_NAME,                                 XCB.XCB_ATOM_STRING,                                 8, 7, @'xcb orm');   XCB.xcb_map_window(connect, xwindow);   XCB.xcb_flush(connect);   Lib.sleep(1);   // рисование контекста   context := XCB.xcb_generate_id(connect);   gc_mask := 0;   gc_list[0] := 0;   XCB.xcb_create_gc(connect, context, xwindow, gc_mask, gc_list);   NEW(image,400,300);   FOR i := 0 TO 399 DO   FOR j := 0 TO 299 DO image[i,j] := 0FFH END END;   XCB.xcb_put_image(connect,                  XCB.XCB_IMAGE_FORMAT_Z_PIXMAP,                  xwindow, context, 400,300, 0,0,0, 24,                                    400*300*4,                  VAL(ADDRESS, image) );   XCB.xcb_flush(connect);   // создание и установка курсора   fcursor := XCB.xcb_generate_id(connect);   XCB.xcb_open_font(connect, fcursor, 6, @'cursor');   icursor := XCB.xcb_generate_id(connect);   XCB.xcb_create_glyph_cursor(connect, icursor,                                     fcursor, fcursor,                                     2, 2 + 1,                         0DD00H,0FFFFH,0FFFFH, 0,0,0);   jcursor := mycursor(0,0,16,26,                                  '*               '                                + '**              '                                + '*w*             '                                + '*ww*            '                                + '*www*           '                                + '*wwww*          '                                + '*wwwww*         '                                + '*wwwwww*        '                                + '*wwwwwww*       '                                + '*wwwwwwww*      '                                + '*wwwwwwwww*     '                                + '*wwwwwwwwww*    '                                + '*wwwwww*****    '                                + '*www*ww*        '                                + '*ww* *ww*       '                                + '*w*  *ww*       '                                + '**    *ww*      '                                + '   *  *ww* * * *'                                + '    *  *ww* * * '                                + '   *   *ww*    *'                                + '    *   ***   * '                                + '   *           *'                                + '    *         * '                                + '   *           *'                                + '    * * * * * * '                                + '   * * * * * * *');   cr_mask := XCB.XCB_CW_CURSOR;   cr_list[0] := jcursor;   XCB.xcb_change_window_attributes(connect, xwindow,                                    cr_mask, cr_list);   XCB.xcb_free_cursor(connect, icursor);   XCB.xcb_close_font( connect, fcursor);   (* обязательная настройка локали ----------------- *)   IF Lib.setlocale(Lib.LC_CTYPE, @(0X+0X)) > 0 THEN END;   (* инициализация xkbcommon без xkbcommon-x11 ----- *]   xkbcont := XKB.xkb_context_new(                               XKB.XKB_CONTEXT_NO_FLAGS);   xkbkmap := XKB.xkb_keymap_new_from_names(xkbcont, 0,                        XKB.XKB_KEYMAP_COMPILE_NO_FLAGS);   xkbstat := XKB.xkb_state_new(xkbkmap);   [* старт xkbcommon-x11 --------------------------- *)   dxkbx11 := DLL.dlopen(                @'libxkbcommon-x11.so.0', DLL.RTLD_LAZY);   x11sext := DLL.dlsym(dxkbx11,                         @'xkb_x11_setup_xkb_extension');   x11core := DLL.dlsym(dxkbx11,                 @'xkb_x11_get_core_keyboard_device_id');   x11kmap := DLL.dlsym(dxkbx11,                      @'xkb_x11_keymap_new_from_device');   x11stat := DLL.dlsym(dxkbx11,                       @'xkb_x11_state_new_from_device');   PUT(@xkb_x11_sext, @x11sext);   PUT(@xkb_x11_core, @x11core);   PUT(@xkb_x11_kmap, @x11kmap);   PUT(@xkb_x11_stat, @x11stat);   (* инициализация xkbcommon с xkbcommon-x11 ------- *)   xkbcont := XKB.xkb_context_new(                               XKB.XKB_CONTEXT_NO_FLAGS);   xdevice := xkb_x11_sext(connect, 1,0, 0, 0,0, 0,0   );   xdevice := xkb_x11_core(connect);   xkbkmap := xkb_x11_kmap(xkbcont, connect,               xdevice, XKB.XKB_KEYMAP_COMPILE_NO_FLAGS);   xkbstat := xkb_x11_stat(xkbkmap, connect, xdevice   );   // обработка сообщений   WHILE stop = 0 DO      event := XCB.xcb_wait_for_event(connect);      kvent := VAL(XCB.xcb_key_event_iterator_t, event);      mvent := VAL(XCB.xcb_but_event_iterator_t, event);      exent := VAL(XCB.xcb_exp_event_iterator_t, event);            // удалятем бит модификатора ------v--      CASE ORD(BIT(event.response_type) * BIT(7FH) ) OF          XCB.XCB_KEY_PRESS :depress := ORD(BIT(kvent.state) * BIT(XCB.XCB_MOD_MASK_SHIFT  ))         + ORD(BIT(kvent.state) * BIT(XCB.XCB_MOD_MASK_CONTROL))// Alt         + ORD(BIT(kvent.state) * BIT(XCB.XCB_MOD_MASK_1      ));// CapsLockxlocked := ORD(BIT(kvent.state) * BIT(XCB.XCB_MOD_MASK_LOCK   ))// NumLock         + ORD(BIT(kvent.state) * BIT(XCB.XCB_MOD_MASK_2      ));xlayout := LSH(ORD(BIT(kvent.state) * BIT(0F000H)),  -13       );              XKB.xkb_state_update_mask(xkbstat,                       depress,   // нажатые модификаторы                       latched,   // временные модификаторы                       xlocked,   // включение CapsLock                       0, 0,      // layout depressed/latched                       xlayout ); // текущая раскладка              keychar := XKB.xkb_state_key_get_one_sym(                                 xkbstat, kvent.detail );              utfchar := XKB.xkb_state_key_get_utf32(                                 xkbstat, kvent.detail );   putsINFO(kvent.detail, 'keycode = ');   putsINFO(xlayout, '   xlayout = ');   putsINFO(keychar, '   keychar = ');   putsINFO(utfchar, '   utfchar = ');              IF utfchar = 27 THEN stop := 1 END;                                             |          XCB.XCB_BUTTON_PRESS :   putsINFO(mvent.detail, 'but_press = ');   putsINFO(mvent.event_x, '   x = ');   putsINFO(mvent.event_y, '   y = ');                                             |          XCB.XCB_EXPOSE :   putsINFO(exent.detail, 'expose = ');   putsINFO(xwindow, '   xwindow = ');   putsINFO(exent.window, '   window = ');                  XCB.xcb_put_image(connect,                  XCB.XCB_IMAGE_FORMAT_Z_PIXMAP,                  xwindow, context, 200,200, 0,0,0, 24,                                    200*200*4,                  VAL(ADDRESS, image) );                  XCB.xcb_put_image(connect,                  XCB.XCB_IMAGE_FORMAT_Z_PIXMAP,                  xwindow, context, 100,100, 200,200,0, 24,                                    100*100*4,                  VAL(ADDRESS, image) );      ELSE        END;   END;   // стандартный курсор стрелка   cr_mask := XCB.XCB_CW_CURSOR;   cr_list[0] := 0;   XCB.xcb_change_window_attributes(connect, xwindow,                                          cr_mask, cr_list);   XCB.xcb_flush(connect);   Lib.sleep(1);   (* освобождаем выделеную память *)   XKB.xkb_state_unref(      xkbstat);   XKB.xkb_keymap_unref(     xkbkmap);   XKB.xkb_context_unref(    xkbcont);   dxkbx11 := DLL.dlclose(   dxkbx11);   XCB.xcb_disconnect(connect);END bexmE_xcb.°aormElf64.linker('d:\e_xcb.elf = asmlXlibc asmlXlxcb asmlXlxkb                                             asmlXlibd bexmE_xcb' )