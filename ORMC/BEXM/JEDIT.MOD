MODULE bexmJedit;(* пример wasm приложения *)IMPORT asmlGfont,       asmlJport, asmlSview,       asmlTedit, asmlTmemo;VAR main : asmlJport.smlMAIN;    edit : asmlTedit.svTEDIT;    cent : asmlTedit.svTEDIT;    righ : asmlTedit.svTEDIT;    alig : asmlSview.svTBUTT;    memo : asmlTmemo.svTMEMO;    PROCEDURE Alig;    BEGIN       memo.alig :=         (memo.alig+1) MOD 4;       memo.DrawView(                  memo.gmn1,                  memo.gmn2,                  memo.gmx1,                  memo.gmx2);    END Alig;BEGIN   asmlJport.ShowINFO(5577, 'Test WebAssembly = ');   (* инит приложения  *)   main :=   asmlJport.InitMain(  );   main.l := 40;   main.t := 40;   main.hstr :=           'Oberon2M ORM';   main.hint :=           'главное окно';   NEW(edit);   edit.InitSize(030,030 ,                 229,059);   edit.anch := {1,3    };   edit.alig := 0;   edit.hint :=               'Пример 0';   edit.text :=        'Пример текста 0';   NEW(cent);   cent.InitSize(030,070 ,                 229,099);   cent.anch := {1,3    };   cent.alig := 1;   cent.hint :=               'Пример 1';   cent.text :=        'Пример текста 1';   NEW(righ);   righ.InitSize(030,110 ,                 197,139);   righ.anch := {1,3    };   righ.alig := 2;   righ.hint :=               'Пример 2';   righ.text :=        'Пример текста 2';   main.PushLast(edit);   main.PushLast(cent);   main.PushLast(righ);   NEW(alig);   alig.InitSize(200,110 ,                 229,139);   alig.anch := {3      };   alig.text := 'OF'     ;   alig.hint :=    'выравнивание текста';   alig.back := 00EAFAE8H;   alig.clic := Alig  ;   main.PushLast(alig);   NEW(memo);   memo.InitSize(030,160 ,                 229,339);   memo.anch := {1,2,3,4};   memo.alig := 0;   memo.hint :=               'Пример 4';   memo.text :=     'Пример мемо текста'     +' с переносом слов';   main.PushLast(memo);   (* цикл приложения  *)   asmlJport.ShowMain(                    main);   asmlJport.MainLoop(  );END bexmJedit.