MODULE bexmJkiss;(* демо примеры вычисления псевдо случайного числа *)(* и очень быстрого вычисления уникального hash на *)(* миллионах строк с минимальной вероятностью повт *)(* орения.                                         *)(* xkiss - алгоритм гпсч криптографического качест *)(*         ва - ScrollLock (forum.oberoncore.ru)   *)  (* arisu - алгоритм гпсч минимально возможный из 7 *)(*         строк -  arisu  (forum.oberoncore.ru)   *)  (* ahash - алгоритм вычисления хэш значения строки *)(*         с минимальной вероятностью повторения в *)(*         милионнах строк - автор arisu           *) (* ВАЖНО: следующее значение псч всегда считаем от *)(*        предыдущего                              *)(* ВАЖНО: в текущей версии ormcode - RSH это-> ROR *) IMPORT asmlJport, asmlGfont,       asmlGview, asmlSview,       asmlSutil, asmlTedit,       asmlTmemo, asmlTdman;TYPE PtrCHAR = POINTER TO               ARRAY OF SCHR;     shaCHAR = ARRAY                  20 OF SCHR;TYPE ArrCHAR = ARRAY OF SCHR;TYPE XkissArState = RECORD        x, a0,a1,c : INTEGER;END;VAR main : asmlJport.smlMAIN;    font : asmlGfont.smlFONT;    edit : asmlTedit.svTEDIT;    abut : asmlSview.svTBUTT;    bbut : asmlSview.svTBUTT;    cbut : asmlSview.svTBUTT;    dbut : asmlSview.svTBUTT;    ebut : asmlSview.svTBUTT;    fbut : asmlSview.svTBUTT;    gbut : asmlSview.svTBUTT;    info : asmlSview.svTBUTT;    memo : asmlTmemo.svTMEMO;    w, h : INTEGER;    asss : INTEGER;    ssss : INTEGER;VAR prng : XkissArState;VAR nul  : shaCHAR;(* -- arisu -------------------------------------- *)    PROCEDURE ahash(s : ArrCHAR) : INTEGER;       (* расчет хэш по алгоритму arisu  *)       (* для вычисления контрол. суммы  *)       (* надо считать с накоплением от  *)       (* предыдущего значения           *)       VAR a,b,i : INTEGER;    BEGIN       a := 0; // а := asss       b := 0;       i := 0;       WHILE s[i] > 0X DO             a := a + ORD(s[i]);             a := a + ASH(a,10);             a := ORD(BIT(a) /                         BIT(ASH(a, -6)) );             b := b - a;             INC(i)                    END;       a := a + ASH(a,03);       a := ORD(BIT(a) / BIT(ASH(a,-11)) );       a := a + ASH(a,15);       RETURN a    END ahash;    PROCEDURE arisu(a : INTEGER) : INTEGER;       (* расчет псч по алгоритму arisu  *)    BEGIN       IF a = 0 THEN a := 1            END;       a := a - ASH(a, 6);       a := ORD(BIT(a) / BIT(ASH(a,-17)) );       a := a - ASH(a, 9);       a := ORD(BIT(a) / BIT(ASH(a, 04)) );       a := a - ASH(a, 3);       a := ORD(BIT(a) / BIT(ASH(a, 10)) );       a := ORD(BIT(a) / BIT(ASH(a,-15)) );       RETURN a    END arisu;(* -- ScrollLock --------------------------------- *)    PROCEDURE XkissArInit(VAR obj : XkissArState;                                x, a0, a1 : INTEGER);    BEGIN      obj.x := x;      obj.a0 := a0 MOD 67108863; (* 2^26 - 1 *)      obj.a1 := a1 MOD 67108863; (* 2^26 - 1 *)      obj.c  := 1;      IF obj.x = 0  THEN obj.x  := 123456  END;      IF obj.a0 < 0 THEN obj.a0 := 0 END;      IF obj.a1 < 0 THEN obj.a1 := 0 END;    END XkissArInit;    PROCEDURE XkissArNext(                   VAR obj : XkissArState) : INTEGER;       CONST mask26 = 003FFFFFFH;             mask31 = 07FFFFFFFH;       VAR t : INTEGER;    BEGIN       (* LFSR part *)       obj.x := ORD(SET(obj.x) / SET(LSH(obj.x, 1)));       obj.x := ORD(SET(obj.x) / SET(RSH(obj.x, 23))                               / SET(RSH(obj.x, 5)));       (* AWC part *)       t := obj.a0 + obj.a1 + obj.c;       obj.a1 := obj.a0;       obj.c  := LSH(t, -26);       obj.a0 := ORD(SET(t) * SET(mask26));       (* Output function *)       RETURN ORD(SET(mask31) * (SET(    obj.x     )                               / SET(LSH(obj.a0, 6))                               / SET(obj.a1 * 29 )));    END XkissArNext;    PROCEDURE xkiss(a : INTEGER) : INTEGER;       (* расчет псч алгоритм ScrollLock *)    BEGIN       IF a = 0 THEN XkissArInit(prng,                       12345678, 3, 2) END;       a := XkissArNext(prng);       RETURN a    END xkiss;(* -- Wikipedia ---------------------------------- *)(* joaat   - one-at-a-time хеш функция Боба             Дженкинса. Для ключей переменн             ой длиныб вычисления контрольн             ой суммы, обнаружения идентичн             ых записей                   *)PROCEDURE joaat   (buf : PtrCHAR;                   len : INTEGER) : INTEGER;   VAR rs, ii  : INTEGER;BEGIN   rs := 0;   FOR ii := 0 TO len-1 DO       rs := rs + ORD(buf[ii]   );       rs := rs + LSH(rs, 10    );       rs := ORD( BIT(rs) / BIT(                  ASH(rs, -6 )));   END;   rs := rs + LSH(rs, 03   );   rs := ORD( BIT(rs) / BIT(              ASH(rs,-11 )));   rs := rs + LSH(rs, 15   );   RETURN rs;END joaat;(* adler32 - хеш функция Марко Адлера. Вычи             сляет значение контрольной сум             мы в соответствии с RFC 1950             для массива из байт          *)PROCEDURE adler32 (buf : PtrCHAR;                   len : INTEGER) : INTEGER;   VAR s1,s2, ii  : INTEGER;BEGIN   s1 := 1;   s2 := 0;   FOR ii := 0 TO len-1 DO       s1 := (s1 + ORD(buf[ii]) ) MOD 65521;       s2 := (s1 + s2) MOD 65521;   END;   RETURN s1 + LSH(s2, 16);END adler32;(* sha_1  -  алгоритм криптографического хе             ширования в соответствии с RFC             3174 для массива из байт     *)PROCEDURE sha_1   (buf : PtrCHAR;                   len : INTEGER) : shaCHAR;   VAR h0,h1,h2,h3,h4  : INTEGER;       r0,r1,r2,r3,r4  : INTEGER;       nm,cn,ii,ff,kk  : INTEGER;       ws : ARRAY 080 OF INTEGER;   VAR rs : shaCHAR;BEGIN   (* начальная инициализация ----------- *)   h0 := 067452301H;   h1 := 0EFCDAB89H;   h2 := 098BADCFEH;   h3 := 010325476H;   h4 := 0C3D2E1F0H;   rs := nul;   cn := len;   (* дополнение до кратности 512 битам   *)   buf[cn] := 80X; INC(cn);   buf[cn] := 00X; INC(cn);   buf[cn] := 00X; INC(cn);   buf[cn] := 00X; INC(cn);   buf[cn] := 00X; INC(cn);   nm := 64 - cn  MOD 64  ;   nm := nm + 64* ORD(nm < 4);   FOR ii := 0 TO nm - 5 DO                 buf[cn] := 0X; INC(cn) END;   (* пишем длину в обратном порядке      *)   len := len * 8;   buf[cn] := CHR( LSH(len, -24) ); INC(cn);   buf[cn] := CHR( LSH(len, -16) ); INC(cn);   buf[cn] := CHR( LSH(len, -08) ); INC(cn);   buf[cn] := CHR(     len       ); INC(cn);   (* разбиваем на части по 512 бит       *)   FOR ii := 0 TO cn DIV 64 - 1 DO       (* инициализация хеш этой части    *)       kk := ii * 64;       r0 := h0;       r1 := h1;       r2 := h2;       r3 := h3;       r4 := h4;       FOR nm := 00 TO 15 DO           ws[nm] := LSH(ORD(buf[kk+0]),24)                   + LSH(ORD(buf[kk+1]),16)                   + LSH(ORD(buf[kk+2]),08)                   +     ORD(buf[kk+3]    );           kk := kk + 4;       END;       FOR nm := 16 TO 79 DO           ws[nm] := RSH(ORD(BIT(ws[nm-03])                           / BIT(ws[nm-08])                           / BIT(ws[nm-14])                           / BIT(ws[nm-16])                                    ), 01 );       END;       (* цикл вычисления хеш этой части  *)       FOR nm := 00 TO 79 DO           IF nm < 20 THEN kk := 05A827999H;              ff := ORD((BIT(r1) * BIT(r2))                     + ((                        -BIT(r1)                               ) * BIT(r3))                       );           EI nm < 40 THEN kk := 06ED9EBA1H;              ff := ORD(BIT(r1) / BIT(r2)                                / BIT(r3) );           EI nm < 60 THEN kk := 08F1BBCDCH;              ff := ORD((BIT(r1) * BIT(r2))                     +  (BIT(r1) * BIT(r3))                     +  (BIT(r2) * BIT(r3))                       );                      ELSE kk := 0CA62C1D6H;              ff := ORD(BIT(r1) / BIT(r2)                                / BIT(r3) );           END;           ff := RSH(r0, 05)                    + ff + r4 + kk + ws[nm];           r4 := r3;           r3 := r2;           r2 := RSH(r1, 30);           r1 := r0;           r0 := ff;       END;       (* добавляем хеш части результату  *)       h0 := h0 + r0;       h1 := h1 + r1;       h2 := h2 + r2;       h3 := h3 + r3;       h4 := h4 + r4;   END;   (* пишем результат big endian -------- *)   rs[00] := CHR(LSH(h0, -24));   rs[01] := CHR(LSH(h0, -16));   rs[02] := CHR(LSH(h0, -08));   rs[03] := CHR(    h0      );   rs[04] := CHR(LSH(h1, -24));   rs[05] := CHR(LSH(h1, -16));   rs[06] := CHR(LSH(h1, -08));   rs[07] := CHR(    h1      );   rs[08] := CHR(LSH(h2, -24));   rs[09] := CHR(LSH(h2, -16));   rs[10] := CHR(LSH(h2, -08));   rs[11] := CHR(    h2      );   rs[12] := CHR(LSH(h3, -24));   rs[13] := CHR(LSH(h3, -16));   rs[14] := CHR(LSH(h3, -08));   rs[15] := CHR(    h3      );   rs[16] := CHR(LSH(h4, -24));   rs[17] := CHR(LSH(h4, -16));   rs[18] := CHR(LSH(h4, -08));   rs[19] := CHR(    h4      );   RETURN rs;END sha_1;(* ripemd160 -криптографическая хеш функция             Ханса Доббертина, Антона Боссе             ларсом и Бартом Пренеля      *)PROCEDURE ripemd160(buf : PtrCHAR;                   len : INTEGER) : shaCHAR;   VAR h0,h1,h2,h3,h4  : INTEGER;       a0,a1,a2,a3,a4  : INTEGER;       b0,b1,b2,b3,b4  : INTEGER;       nm,cn,ii,ff,kk  : INTEGER;       wi : ARRAY 080 OF INTEGER;       wj : ARRAY 080 OF INTEGER;       ri : ARRAY 080 OF INTEGER;       rj : ARRAY 080 OF INTEGER;       ws : ARRAY 016 OF INTEGER;   VAR rs : shaCHAR;BEGIN   (* начальная инициализация ----------- *)   h0 := 067452301H;   h1 := 0EFCDAB89H;   h2 := 098BADCFEH;   h3 := 010325476H;   h4 := 0C3D2E1F0H;   rs := nul;   cn := len;   // kk := 000000000H;   wi[00] := 00; ri[00] := 11;   wi[01] := 01; ri[01] := 14;   wi[02] := 02; ri[02] := 15;   wi[03] := 03; ri[03] := 12;   wi[04] := 04; ri[04] := 05;   wi[05] := 05; ri[05] := 08;   wi[06] := 06; ri[06] := 07;   wi[07] := 07; ri[07] := 09;   wi[08] := 08; ri[08] := 11;   wi[09] := 09; ri[09] := 13;   wi[10] := 10; ri[10] := 14;   wi[11] := 11; ri[11] := 15;   wi[12] := 12; ri[12] := 06;   wi[13] := 13; ri[13] := 07;   wi[14] := 14; ri[14] := 09;   wi[15] := 15; ri[15] := 08;   // kk := 05A827999H;   wi[16] := 07; ri[16] := 07;   wi[17] := 04; ri[17] := 06;   wi[18] := 13; ri[18] := 08;   wi[19] := 01; ri[19] := 13;   wi[20] := 10; ri[20] := 11;   wi[21] := 06; ri[21] := 09;   wi[22] := 15; ri[22] := 07;   wi[23] := 03; ri[23] := 15;   wi[24] := 12; ri[24] := 07;   wi[25] := 00; ri[25] := 12;   wi[26] := 09; ri[26] := 15;   wi[27] := 05; ri[27] := 09;   wi[28] := 02; ri[28] := 11;   wi[29] := 14; ri[29] := 07;   wi[30] := 11; ri[30] := 13;   wi[31] := 08; ri[31] := 12;   // kk := 06ED9EBA1H;   wi[32] := 03; ri[32] := 11;   wi[33] := 10; ri[33] := 13;   wi[34] := 14; ri[34] := 06;   wi[35] := 04; ri[35] := 07;   wi[36] := 09; ri[36] := 14;   wi[37] := 15; ri[37] := 09;   wi[38] := 08; ri[38] := 13;   wi[39] := 01; ri[39] := 15;   wi[40] := 02; ri[40] := 14;   wi[41] := 07; ri[41] := 08;   wi[42] := 00; ri[42] := 13;   wi[43] := 06; ri[43] := 06;   wi[44] := 13; ri[44] := 05;   wi[45] := 11; ri[45] := 12;   wi[46] := 05; ri[46] := 07;   wi[47] := 12; ri[47] := 05;   // kk := 08F1BBCDCH;   wi[48] := 01; ri[48] := 11;   wi[49] := 09; ri[49] := 12;   wi[50] := 11; ri[50] := 14;   wi[51] := 10; ri[51] := 15;   wi[52] := 00; ri[52] := 14;   wi[53] := 08; ri[53] := 15;   wi[54] := 12; ri[54] := 09;   wi[55] := 04; ri[55] := 08;   wi[56] := 13; ri[56] := 09;   wi[57] := 03; ri[57] := 14;   wi[58] := 07; ri[58] := 05;   wi[59] := 15; ri[59] := 06;   wi[60] := 14; ri[60] := 08;   wi[61] := 05; ri[61] := 06;   wi[62] := 06; ri[62] := 05;   wi[63] := 02; ri[63] := 12;   // kk := 0A953FD4EH;   wi[64] := 04; ri[64] := 09;   wi[65] := 00; ri[65] := 15;   wi[66] := 05; ri[66] := 05;   wi[67] := 09; ri[67] := 11;   wi[68] := 07; ri[68] := 06;   wi[69] := 12; ri[69] := 08;   wi[70] := 02; ri[70] := 13;   wi[71] := 10; ri[71] := 12;   wi[72] := 14; ri[72] := 05;   wi[73] := 01; ri[73] := 12;   wi[74] := 03; ri[74] := 13;   wi[75] := 08; ri[75] := 14;   wi[76] := 11; ri[76] := 11;   wi[77] := 06; ri[77] := 08;   wi[78] := 15; ri[78] := 05;   wi[79] := 13; ri[79] := 06;   // ff := 050A28BE6H;   wj[00] := 05; rj[00] := 08;   wj[01] := 14; rj[01] := 09;   wj[02] := 07; rj[02] := 09;   wj[03] := 00; rj[03] := 11;   wj[04] := 09; rj[04] := 13;   wj[05] := 02; rj[05] := 15;   wj[06] := 11; rj[06] := 15;   wj[07] := 04; rj[07] := 05;   wj[08] := 13; rj[08] := 07;   wj[09] := 06; rj[09] := 07;   wj[10] := 15; rj[10] := 08;   wj[11] := 08; rj[11] := 11;   wj[12] := 01; rj[12] := 14;   wj[13] := 10; rj[13] := 14;   wj[14] := 03; rj[14] := 12;   wj[15] := 12; rj[15] := 06;   // ff := 05C4DD124H;   wj[16] := 06; rj[16] := 09;   wj[17] := 11; rj[17] := 13;   wj[18] := 03; rj[18] := 15;   wj[19] := 07; rj[19] := 07;   wj[20] := 00; rj[20] := 12;   wj[21] := 13; rj[21] := 08;   wj[22] := 05; rj[22] := 09;   wj[23] := 10; rj[23] := 11;   wj[24] := 14; rj[24] := 07;   wj[25] := 15; rj[25] := 07;   wj[26] := 08; rj[26] := 12;   wj[27] := 12; rj[27] := 07;   wj[28] := 04; rj[28] := 06;   wj[29] := 09; rj[29] := 15;   wj[30] := 01; rj[30] := 13;   wj[31] := 02; rj[31] := 11;   // ff := 06D703EF3H;   wj[32] := 15; rj[32] := 09;   wj[33] := 05; rj[33] := 07;   wj[34] := 01; rj[34] := 15;   wj[35] := 03; rj[35] := 11;   wj[36] := 07; rj[36] := 08;   wj[37] := 14; rj[37] := 06;   wj[38] := 06; rj[38] := 06;   wj[39] := 09; rj[39] := 14;   wj[40] := 11; rj[40] := 12;   wj[41] := 08; rj[41] := 13;   wj[42] := 12; rj[42] := 05;   wj[43] := 02; rj[43] := 14;   wj[44] := 10; rj[44] := 13;   wj[45] := 00; rj[45] := 13;   wj[46] := 04; rj[46] := 07;   wj[47] := 13; rj[47] := 05;   // ff := 07A6D76E9H;   wj[48] := 08; rj[48] := 15;   wj[49] := 06; rj[49] := 05;   wj[50] := 04; rj[50] := 08;   wj[51] := 01; rj[51] := 11;   wj[52] := 03; rj[52] := 14;   wj[53] := 11; rj[53] := 14;   wj[54] := 15; rj[54] := 06;   wj[55] := 00; rj[55] := 14;   wj[56] := 05; rj[56] := 06;   wj[57] := 12; rj[57] := 09;   wj[58] := 02; rj[58] := 12;   wj[59] := 13; rj[59] := 09;   wj[60] := 09; rj[60] := 12;   wj[61] := 07; rj[61] := 05;   wj[62] := 10; rj[62] := 15;   wj[63] := 14; rj[63] := 08;   // ff := 0;   wj[64] := 12; rj[64] := 08;   wj[65] := 15; rj[65] := 05;   wj[66] := 10; rj[66] := 12;   wj[67] := 04; rj[67] := 09;   wj[68] := 01; rj[68] := 12;   wj[69] := 05; rj[69] := 05;   wj[70] := 08; rj[70] := 14;   wj[71] := 07; rj[71] := 06;   wj[72] := 06; rj[72] := 08;   wj[73] := 02; rj[73] := 13;   wj[74] := 13; rj[74] := 06;   wj[75] := 14; rj[75] := 05;   wj[76] := 00; rj[76] := 15;   wj[77] := 03; rj[77] := 13;   wj[78] := 09; rj[78] := 11;   wj[79] := 11; rj[79] := 11;   (* дополнение до кратности 512 битам   *)   buf[cn] := 80X; INC(cn);   nm := 64 - cn  MOD 64  ;   nm := nm + 64* ORD(nm < 8);   FOR ii := 0 TO nm - 9 DO                 buf[cn] := 0X; INC(cn) END;   (* пишем длину в прямом порядке        *)   len := len * 8;   buf[cn] := CHR(     len       ); INC(cn);   buf[cn] := CHR( LSH(len, -08) ); INC(cn);   buf[cn] := CHR( LSH(len, -16) ); INC(cn);   buf[cn] := CHR( LSH(len, -24) ); INC(cn);   buf[cn] := 00X; INC(cn);   buf[cn] := 00X; INC(cn);   buf[cn] := 00X; INC(cn);   buf[cn] := 00X; INC(cn);   (* разбиваем на части по 512 бит       *)   FOR ii := 0 TO cn DIV 64 - 1 DO       (* инициализация хеш этой части    *)       kk := ii * 64;       a0 := h0;       a1 := h1;       a2 := h2;       a3 := h3;       a4 := h4;       b0 := h0;       b1 := h1;       b2 := h2;       b3 := h3;       b4 := h4;       FOR nm := 00 TO 15 DO           ws[nm] := LSH(ORD(buf[kk+3]),24)                   + LSH(ORD(buf[kk+2]),16)                   + LSH(ORD(buf[kk+1]),08)                   +     ORD(buf[kk+0]    );           kk := kk + 4;       END;       (* цикл вычисления хеш этой части  *)       FOR nm := 00 TO 79 DO           IF nm < 16 THEN              kk := ORD( BIT(a1) / BIT(a2)                                 / BIT(a3));              ff := ORD( BIT(b1) /                       ( BIT(b2) +                                 (-BIT(b3))                                         ))                               + 050A28BE6H;           EI nm < 32 THEN              kk := ORD((BIT(a1) * BIT(a2))                     + ((                        -BIT(a1)                               ) * BIT(a3))                                          )                               + 05A827999H;              ff := ORD((BIT(b1) * BIT(b3))                      + (BIT(b2) *                                 (-BIT(b3))                                         ))                               + 05C4DD124H;           EI nm < 48 THEN              kk := ORD((BIT(a1) +                       (-BIT(a2)))                                 / BIT(a3))                               + 06ED9EBA1H;              ff := ORD((BIT(b1) +                       (-BIT(b2)))                                 / BIT(b3))                               + 06D703EF3H;           EI nm < 64 THEN              kk := ORD((BIT(a1) * BIT(a3))                      + (BIT(a2) *                                 (-BIT(a3))                                         ))                               + 08F1BBCDCH;              ff := ORD((BIT(b1) * BIT(b2))                     + ((                        -BIT(b1)                               ) * BIT(b3))                                          )                               + 07A6D76E9H;                      ELSE              kk := ORD( BIT(a1) /                       ( BIT(a2) +                                 (-BIT(a3))                                         ))                               + 0A953FD4EH;              ff := ORD( BIT(b1) / BIT(b2)                                 / BIT(b3));           END;           kk := RSH(a0 + kk + ws[wi[nm]],                               ri[nm]) + a4;           a0 := a4;           a4 := a3;           a3 := RSH(a2, 10);           a2 := a1;           a1 := kk;           ff := RSH(b0 + ff + ws[wj[nm]],                               rj[nm]) + b4;           b0 := b4;           b4 := b3;           b3 := RSH(b2, 10);           b2 := b1;           b1 := ff;       END;       (* добавляем хеш части результату  *)       ff := h1 + a2 + b3;       h1 := h2 + a3 + b4;       h2 := h3 + a4 + b0;       h3 := h4 + a0 + b1;       h4 := h0 + a1 + b2;       h0 := ff;   END;   (* пишем результат little endian ----- *)   rs[00] := CHR(    h0      );   rs[01] := CHR(LSH(h0, -08));   rs[02] := CHR(LSH(h0, -16));   rs[03] := CHR(LSH(h0, -24));   rs[04] := CHR(    h1      );   rs[05] := CHR(LSH(h1, -08));   rs[06] := CHR(LSH(h1, -16));   rs[07] := CHR(LSH(h1, -24));   rs[08] := CHR(    h2      );   rs[09] := CHR(LSH(h2, -08));   rs[10] := CHR(LSH(h2, -16));   rs[11] := CHR(LSH(h2, -24));   rs[12] := CHR(    h3      );   rs[13] := CHR(LSH(h3, -08));   rs[14] := CHR(LSH(h3, -16));   rs[15] := CHR(LSH(h3, -24));   rs[16] := CHR(    h4      );   rs[17] := CHR(LSH(h4, -08));   rs[18] := CHR(LSH(h4, -16));   rs[19] := CHR(LSH(h4, -24));   RETURN rs;END ripemd160;   PROCEDURE HexToStr (int : INTEGER;                            VAR str : ARRAY OF SCHR);      VAR dig : ARRAY 24 OF SCHR;   BEGIN      dig  := '0123456789ABCDEF';      str[8] := 00X;      str[1] := dig[ORD(BIT(    int     )*BIT(0FH))];      str[0] := dig[ORD(BIT(ASH(int,-04))*BIT(0FH))];      str[3] := dig[ORD(BIT(ASH(int,-08))*BIT(0FH))];      str[2] := dig[ORD(BIT(ASH(int,-12))*BIT(0FH))];      str[5] := dig[ORD(BIT(ASH(int,-16))*BIT(0FH))];      str[4] := dig[ORD(BIT(ASH(int,-20))*BIT(0FH))];      str[7] := dig[ORD(BIT(ASH(int,-24))*BIT(0FH))];      str[6] := dig[ORD(BIT(ASH(int,-28))*BIT(0FH))];   END HexToStr;(* ----------------------------------------------- *)   PROCEDURE Abut;      VAR n,t : INTEGER;          num : ARRAY 20 OF SCHR;   BEGIN      n := ahash(edit.text$);      asmlJport.IntToStr(n, num);      memo.PastText('хэш = '                   + num$ + 0DX);      edit.text := edit.text$ + '1';      edit.DrawView(edit.gmn1, edit.gmn2,                    edit.gmx1, edit.gmx2);      memo.DrawView(memo.gmn1, memo.gmn2,                    memo.gmx1, memo.gmx2);   END Abut;   PROCEDURE Bbut;      VAR n,t : INTEGER;          num : ARRAY 20 OF SCHR;   BEGIN      n := arisu(asss);      asmlJport.IntToStr(n, num);      memo.PastText('псч = '                   + num$ + 0DX);      asss := n;      memo.DrawView(memo.gmn1, memo.gmn2,                    memo.gmx1, memo.gmx2);   END Bbut;   PROCEDURE Cbut;      VAR n,t : INTEGER;          num : ARRAY 20 OF SCHR;   BEGIN      n := xkiss(ssss);      asmlJport.IntToStr(n, num);      memo.PastText('pch = '                   + num$ + 0DX);      ssss := n;      memo.DrawView(memo.gmn1, memo.gmn2,                    memo.gmx1, memo.gmx2);   END Cbut;   PROCEDURE Dbut;      VAR n,t : INTEGER;          num : ARRAY 20 OF SCHR;   BEGIN      n := joaat(VAL(PtrCHAR,@edit.text),                         LEN(edit.text$));      asmlJport.IntToStr(n, num);      memo.PastText('joaat = '                   + num$ + 0DX);      edit.text := edit.text$ + '1';      edit.DrawView(edit.gmn1, edit.gmn2,                    edit.gmx1, edit.gmx2);      memo.DrawView(memo.gmn1, memo.gmn2,                    memo.gmx1, memo.gmx2);   END Dbut;   PROCEDURE Ebut;      VAR n,t : INTEGER;          num : ARRAY 20 OF SCHR;   BEGIN      n := adler32(                  VAL(PtrCHAR,@edit.text),                         LEN(edit.text$));      asmlJport.IntToStr(n, num);      memo.PastText('adler = '                   + num$ + 0DX);      edit.text := edit.text$ + '1';      edit.DrawView(edit.gmn1, edit.gmn2,                    edit.gmx1, edit.gmx2);      memo.DrawView(memo.gmn1, memo.gmn2,                    memo.gmx1, memo.gmx2);   END Ebut;   PROCEDURE Fbut;      VAR sha : shaCHAR;          len : INTEGER;          num : ARRAY 16 OF SCHR;          buf : ARRAY 1024 OF SCHR;   BEGIN      buf := edit.text$;      len := LEN(buf$);      sha := sha_1(VAL(PtrCHAR, @buf[0]),                                    len );      memo.PastText('sha-1 = ');      HexToStr(VAL(INTEGER, sha[00]),num);                memo.PastText(num$ + ' ');      HexToStr(VAL(INTEGER, sha[04]),num);                memo.PastText(num$ + ' ');      HexToStr(VAL(INTEGER, sha[08]),num);                memo.PastText(num$ + ' ');      HexToStr(VAL(INTEGER, sha[12]),num);                memo.PastText(num$ + ' ');      HexToStr(VAL(INTEGER, sha[16]),num);                memo.PastText(num$ + 0DX);      edit.text := edit.text$;      edit.DrawView(edit.gmn1, edit.gmn2,                    edit.gmx1, edit.gmx2);      memo.DrawView(memo.gmn1, memo.gmn2,                    memo.gmx1, memo.gmx2);   END Fbut;   PROCEDURE Gbut;      VAR sha : shaCHAR;          len : INTEGER;          num : ARRAY 16 OF SCHR;          buf : ARRAY 1024 OF SCHR;   BEGIN      buf := edit.text$;      len := LEN(buf$);      sha := ripemd160(             VAL(PtrCHAR, @buf[0]), len );      memo.PastText('ripemd-160 = ');      HexToStr(VAL(INTEGER, sha[00]),num);                memo.PastText(num$ + ' ');      HexToStr(VAL(INTEGER, sha[04]),num);                memo.PastText(num$ + ' ');      HexToStr(VAL(INTEGER, sha[08]),num);                memo.PastText(num$ + ' ');      HexToStr(VAL(INTEGER, sha[12]),num);                memo.PastText(num$ + ' ');      HexToStr(VAL(INTEGER, sha[16]),num);                memo.PastText(num$ + 0DX);      edit.text := edit.text$;      edit.DrawView(edit.gmn1, edit.gmn2,                    edit.gmx1, edit.gmx2);      memo.DrawView(memo.gmn1, memo.gmn2,                    memo.gmx1, memo.gmx2);   END Gbut;   PROCEDURE get_prop(             );   BEGIN      asmlTdman.LogoProg(memo,                      10,10,250,140);      asmlGview.Beep;   END get_prop;BEGIN   (* инит clipboard   *)   asmlSutil.clpproc :=       asmlJport.clipproc;   (* инит приложения  *)   main :=   asmlJport.InitMain(  );   main.back := 00CCE0D4H;   w := 700;   h := 500;   main.gmx1 := w;   main.gmx2 := h;   main.smx1 := w;   main.smx2 := h;   main.hstr := 'Демо примеры гпсч и хэш: arisu, ScrollLock'              + ' - forum.oberoncore.ru';   NEW(edit);   edit.InitSize( 030,30,                w-380,53);   edit.anch := {1,3    };   edit.text := 'Строка1';   main.PushLast(edit);   NEW(abut);   abut.InitSize(w-350,30,                 w-30,53);   abut.anch := {3      };   abut.text := 'Hash функция - arisu (forum.oberoncore.ru)';   abut.back := 00EAFAE8H;   abut.clic := Abut  ;   NEW(bbut);   bbut.InitSize(w-350,60,                 w-30,83);   bbut.anch := {3      };   bbut.text := 'Гпсч функция - arisu (forum.oberoncore.ru)';   bbut.back := 00EAFAE8H;   asss := 1; // нач.зн   bbut.clic := Bbut  ;   NEW(cbut);   cbut.InitSize(w-350,95,                w-30,118);   cbut.anch := {3      };   cbut.text := 'Гпсч функция - ScrollLock (forum.oberoncore.ru)';   cbut.back := 00EAFAE8H;   cbut.clic := Cbut  ;   NEW(dbut);   dbut.InitSize(w-350,130,                w-30,153);   dbut.anch := {3      };   dbut.text := 'Hash функция - Боба Дженкинса';   dbut.back := 00EAFAE8H;   dbut.clic := Dbut  ;   NEW(ebut);   ebut.InitSize(w-350,160,                w-30,183);   ebut.anch := {3      };   ebut.text := 'Hash функция - Марко Адлера';   ebut.back := 00EAFAE8H;   ebut.clic := Ebut  ;   NEW(fbut);   fbut.InitSize(w-350,195,                w-30,218);   fbut.anch := {3      };   fbut.text := 'Hash функция SHA-1 по RFC 3174';   fbut.back := 00EAFAE8H;   fbut.clic := Fbut  ;   NEW(gbut);   gbut.InitSize(w-350,230,                w-30,253);   gbut.anch := {3      };   gbut.text := 'Hash функция RIPEMD-160 Ханса Доббертина';   gbut.back := 00EAFAE8H;   gbut.clic := Gbut  ;   main.PushLast(abut);   main.PushLast(bbut);   main.PushLast(cbut);   main.PushLast(dbut);   main.PushLast(ebut);   main.PushLast(fbut);   main.PushLast(gbut);   (* шрифт для memo   *)   font := asmlGfont.           get_FONT(        'Consolas',14,{});   NEW(memo);   memo.InitSize( 030,60 ,              w-380,h-55);   memo.anch := {1,2,3,4};   memo.font := font;   memo.vert := asmlSview.           v_scroll(memo);   main.PushLast(memo);   NEW(info);   info.InitSize(w-300,h-78 ,                 w-250,h-55);   info.anch := {3,4    };   info.text := 'Info';   info.back := 00EAFAE8H;   info.clic := get_prop ;   info.hint :=         'тест float f64';   main.PushLast(info);   (* цикл приложения  *)   asmlJport.ShowMain(                    main);   asmlJport.MainLoop(  );END bexmJkiss.°aormJwasm.linker('d:\jkiss.wasm = asmlJlibc asmlJlibd asmlGfont asmlGdraw                                    asmlGdsvg asmlGview asmlGmain asmlJport                asmlSview asmlSutil asmlTedit asmlTmemo asmlTdman bexmJkiss' )