MODULE adexER160;       (* MT, 31.01.2026 *)(* Oberon-2M Linker. Android Dalvik VM    *)TYPE PtrCHAR = POINTER TO ARRAY OF SCHR;     shaCHAR = ARRAY 20 OF SCHR;VAR nul : shaCHAR;(* crc32   - cyclic redundancy check 32 хеш             функция в основе которой делен             ие двоичных данных на фиксиров             анный полином                    - обычно: 0104C11DB7H *)PROCEDURE crc32   (buf : PtrCHAR;                   len : INTEGER) : INTEGER;   VAR crc, i : INTEGER;                  tab : ARRAY 16 OF INTEGER;BEGIN   tab[00] := 000000000H;   tab[01] := 01DB71064H;   tab[02] := 03B6E20C8H;   tab[03] := 026D930ACH;   tab[04] := 076DC4190H;   tab[05] := 06B6B51F4H;   tab[06] := 04DB26158H;   tab[07] := 05005713CH;   tab[08] := 0EDB88320H;   tab[09] := 0F00F9344H;   tab[10] := 0D6D6A3E8H;   tab[11] := 0CB61B38CH;   tab[12] := 09B64C2B0H;   tab[13] := 086D3D2D4H;   tab[14] := 0A00AE278H;   tab[15] := 0BDBDF21CH;   crc := 0FFFFFFFFH;   FOR i := 0 TO len - 1 DO      crc := ORD(BIT(crc)/BIT(ORD(buf[i])));      crc := ORD(BIT(tab[ ORD(BIT(crc)           * BIT(0FH))] )/BIT(LSH(crc,-4)));      crc := ORD(BIT(tab[ ORD(BIT(crc)           * BIT(0FH))] )/BIT(LSH(crc,-4)));   END;   RETURN ORD( BIT(crc) / BIT(0FFFFFFFFH) );END crc32;(* joaat   - one-at-a-time хеш функция Боба             Дженкинса. Для ключей переменн             ой длиныб вычисления контрольн             ой суммы, обнаружения идентичн             ых записей                   *)PROCEDURE joaat   (buf : PtrCHAR;                   len : INTEGER) : INTEGER;   VAR rs, ii  : INTEGER;BEGIN   rs := 0;   FOR ii := 0 TO len-1 DO       rs := rs + ORD(buf[ii]   );       rs := rs + LSH(rs, 10    );       rs := ORD( BIT(rs) / BIT(                  ASH(rs, -6 )));   END;   rs := rs + LSH(rs, 03   );   rs := ORD( BIT(rs) / BIT(              ASH(rs,-11 )));   rs := rs + LSH(rs, 15   );   RETURN rs;END joaat;(* ripemd160 -криптографическая хеш функция             Ханса Доббертина, Антона Боссе             ларсом и Бартом Пренеля      *)PROCEDURE ripemd160(buf : PtrCHAR;                   len : INTEGER) : shaCHAR;   VAR h0,h1,h2,h3,h4  : INTEGER;       a0,a1,a2,a3,a4  : INTEGER;       b0,b1,b2,b3,b4  : INTEGER;       nm,cn,ii,ff,kk  : INTEGER;       wi : ARRAY 080 OF INTEGER;       wj : ARRAY 080 OF INTEGER;       ri : ARRAY 080 OF INTEGER;       rj : ARRAY 080 OF INTEGER;       ws : ARRAY 016 OF INTEGER;   VAR rs : shaCHAR;BEGIN   (* начальная инициализация ----------- *)   h0 := 067452301H;   h1 := 0EFCDAB89H;   h2 := 098BADCFEH;   h3 := 010325476H;   h4 := 0C3D2E1F0H;   rs := nul;   cn := len;   // kk := 000000000H;   wi[00] := 00; ri[00] := 11;   wi[01] := 01; ri[01] := 14;   wi[02] := 02; ri[02] := 15;   wi[03] := 03; ri[03] := 12;   wi[04] := 04; ri[04] := 05;   wi[05] := 05; ri[05] := 08;   wi[06] := 06; ri[06] := 07;   wi[07] := 07; ri[07] := 09;   wi[08] := 08; ri[08] := 11;   wi[09] := 09; ri[09] := 13;   wi[10] := 10; ri[10] := 14;   wi[11] := 11; ri[11] := 15;   wi[12] := 12; ri[12] := 06;   wi[13] := 13; ri[13] := 07;   wi[14] := 14; ri[14] := 09;   wi[15] := 15; ri[15] := 08;   // kk := 05A827999H;   wi[16] := 07; ri[16] := 07;   wi[17] := 04; ri[17] := 06;   wi[18] := 13; ri[18] := 08;   wi[19] := 01; ri[19] := 13;   wi[20] := 10; ri[20] := 11;   wi[21] := 06; ri[21] := 09;   wi[22] := 15; ri[22] := 07;   wi[23] := 03; ri[23] := 15;   wi[24] := 12; ri[24] := 07;   wi[25] := 00; ri[25] := 12;   wi[26] := 09; ri[26] := 15;   wi[27] := 05; ri[27] := 09;   wi[28] := 02; ri[28] := 11;   wi[29] := 14; ri[29] := 07;   wi[30] := 11; ri[30] := 13;   wi[31] := 08; ri[31] := 12;   // kk := 06ED9EBA1H;   wi[32] := 03; ri[32] := 11;   wi[33] := 10; ri[33] := 13;   wi[34] := 14; ri[34] := 06;   wi[35] := 04; ri[35] := 07;   wi[36] := 09; ri[36] := 14;   wi[37] := 15; ri[37] := 09;   wi[38] := 08; ri[38] := 13;   wi[39] := 01; ri[39] := 15;   wi[40] := 02; ri[40] := 14;   wi[41] := 07; ri[41] := 08;   wi[42] := 00; ri[42] := 13;   wi[43] := 06; ri[43] := 06;   wi[44] := 13; ri[44] := 05;   wi[45] := 11; ri[45] := 12;   wi[46] := 05; ri[46] := 07;   wi[47] := 12; ri[47] := 05;   // kk := 08F1BBCDCH;   wi[48] := 01; ri[48] := 11;   wi[49] := 09; ri[49] := 12;   wi[50] := 11; ri[50] := 14;   wi[51] := 10; ri[51] := 15;   wi[52] := 00; ri[52] := 14;   wi[53] := 08; ri[53] := 15;   wi[54] := 12; ri[54] := 09;   wi[55] := 04; ri[55] := 08;   wi[56] := 13; ri[56] := 09;   wi[57] := 03; ri[57] := 14;   wi[58] := 07; ri[58] := 05;   wi[59] := 15; ri[59] := 06;   wi[60] := 14; ri[60] := 08;   wi[61] := 05; ri[61] := 06;   wi[62] := 06; ri[62] := 05;   wi[63] := 02; ri[63] := 12;   // kk := 0A953FD4EH;   wi[64] := 04; ri[64] := 09;   wi[65] := 00; ri[65] := 15;   wi[66] := 05; ri[66] := 05;   wi[67] := 09; ri[67] := 11;   wi[68] := 07; ri[68] := 06;   wi[69] := 12; ri[69] := 08;   wi[70] := 02; ri[70] := 13;   wi[71] := 10; ri[71] := 12;   wi[72] := 14; ri[72] := 05;   wi[73] := 01; ri[73] := 12;   wi[74] := 03; ri[74] := 13;   wi[75] := 08; ri[75] := 14;   wi[76] := 11; ri[76] := 11;   wi[77] := 06; ri[77] := 08;   wi[78] := 15; ri[78] := 05;   wi[79] := 13; ri[79] := 06;   // ff := 050A28BE6H;   wj[00] := 05; rj[00] := 08;   wj[01] := 14; rj[01] := 09;   wj[02] := 07; rj[02] := 09;   wj[03] := 00; rj[03] := 11;   wj[04] := 09; rj[04] := 13;   wj[05] := 02; rj[05] := 15;   wj[06] := 11; rj[06] := 15;   wj[07] := 04; rj[07] := 05;   wj[08] := 13; rj[08] := 07;   wj[09] := 06; rj[09] := 07;   wj[10] := 15; rj[10] := 08;   wj[11] := 08; rj[11] := 11;   wj[12] := 01; rj[12] := 14;   wj[13] := 10; rj[13] := 14;   wj[14] := 03; rj[14] := 12;   wj[15] := 12; rj[15] := 06;   // ff := 05C4DD124H;   wj[16] := 06; rj[16] := 09;   wj[17] := 11; rj[17] := 13;   wj[18] := 03; rj[18] := 15;   wj[19] := 07; rj[19] := 07;   wj[20] := 00; rj[20] := 12;   wj[21] := 13; rj[21] := 08;   wj[22] := 05; rj[22] := 09;   wj[23] := 10; rj[23] := 11;   wj[24] := 14; rj[24] := 07;   wj[25] := 15; rj[25] := 07;   wj[26] := 08; rj[26] := 12;   wj[27] := 12; rj[27] := 07;   wj[28] := 04; rj[28] := 06;   wj[29] := 09; rj[29] := 15;   wj[30] := 01; rj[30] := 13;   wj[31] := 02; rj[31] := 11;   // ff := 06D703EF3H;   wj[32] := 15; rj[32] := 09;   wj[33] := 05; rj[33] := 07;   wj[34] := 01; rj[34] := 15;   wj[35] := 03; rj[35] := 11;   wj[36] := 07; rj[36] := 08;   wj[37] := 14; rj[37] := 06;   wj[38] := 06; rj[38] := 06;   wj[39] := 09; rj[39] := 14;   wj[40] := 11; rj[40] := 12;   wj[41] := 08; rj[41] := 13;   wj[42] := 12; rj[42] := 05;   wj[43] := 02; rj[43] := 14;   wj[44] := 10; rj[44] := 13;   wj[45] := 00; rj[45] := 13;   wj[46] := 04; rj[46] := 07;   wj[47] := 13; rj[47] := 05;   // ff := 07A6D76E9H;   wj[48] := 08; rj[48] := 15;   wj[49] := 06; rj[49] := 05;   wj[50] := 04; rj[50] := 08;   wj[51] := 01; rj[51] := 11;   wj[52] := 03; rj[52] := 14;   wj[53] := 11; rj[53] := 14;   wj[54] := 15; rj[54] := 06;   wj[55] := 00; rj[55] := 14;   wj[56] := 05; rj[56] := 06;   wj[57] := 12; rj[57] := 09;   wj[58] := 02; rj[58] := 12;   wj[59] := 13; rj[59] := 09;   wj[60] := 09; rj[60] := 12;   wj[61] := 07; rj[61] := 05;   wj[62] := 10; rj[62] := 15;   wj[63] := 14; rj[63] := 08;   // ff := 0;   wj[64] := 12; rj[64] := 08;   wj[65] := 15; rj[65] := 05;   wj[66] := 10; rj[66] := 12;   wj[67] := 04; rj[67] := 09;   wj[68] := 01; rj[68] := 12;   wj[69] := 05; rj[69] := 05;   wj[70] := 08; rj[70] := 14;   wj[71] := 07; rj[71] := 06;   wj[72] := 06; rj[72] := 08;   wj[73] := 02; rj[73] := 13;   wj[74] := 13; rj[74] := 06;   wj[75] := 14; rj[75] := 05;   wj[76] := 00; rj[76] := 15;   wj[77] := 03; rj[77] := 13;   wj[78] := 09; rj[78] := 11;   wj[79] := 11; rj[79] := 11;   (* дополнение до кратности 512 битам   *)   buf[cn] := 80X; INC(cn);   nm := 64 - cn  MOD 64  ;   nm := nm + 64* ORD(nm < 8);   FOR ii := 0 TO nm - 9 DO                 buf[cn] := 0X; INC(cn) END;   (* пишем длину в прямом порядке        *)   len := len * 8;   buf[cn] := CHR(     len       ); INC(cn);   buf[cn] := CHR( LSH(len, -08) ); INC(cn);   buf[cn] := CHR( LSH(len, -16) ); INC(cn);   buf[cn] := CHR( LSH(len, -24) ); INC(cn);   buf[cn] := 00X; INC(cn);   buf[cn] := 00X; INC(cn);   buf[cn] := 00X; INC(cn);   buf[cn] := 00X; INC(cn);   (* разбиваем на части по 512 бит       *)   FOR ii := 0 TO cn DIV 64 - 1 DO       (* инициализация хеш этой части    *)       kk := ii * 64;       a0 := h0;       a1 := h1;       a2 := h2;       a3 := h3;       a4 := h4;       b0 := h0;       b1 := h1;       b2 := h2;       b3 := h3;       b4 := h4;       FOR nm := 00 TO 15 DO           ws[nm] := LSH(ORD(buf[kk+3]),24)                   + LSH(ORD(buf[kk+2]),16)                   + LSH(ORD(buf[kk+1]),08)                   +     ORD(buf[kk+0]    );           kk := kk + 4;       END;       (* цикл вычисления хеш этой части  *)       FOR nm := 00 TO 79 DO           IF nm < 16 THEN              kk := ORD( BIT(a1) / BIT(a2)                                 / BIT(a3));              ff := ORD( BIT(b1) /                       ( BIT(b2) +                                 (-BIT(b3))                                         ))                               + 050A28BE6H;           EI nm < 32 THEN              kk := ORD((BIT(a1) * BIT(a2))                     + ((                        -BIT(a1)                               ) * BIT(a3))                                          )                               + 05A827999H;              ff := ORD((BIT(b1) * BIT(b3))                      + (BIT(b2) *                                 (-BIT(b3))                                         ))                               + 05C4DD124H;           EI nm < 48 THEN              kk := ORD((BIT(a1) +                       (-BIT(a2)))                                 / BIT(a3))                               + 06ED9EBA1H;              ff := ORD((BIT(b1) +                       (-BIT(b2)))                                 / BIT(b3))                               + 06D703EF3H;           EI nm < 64 THEN              kk := ORD((BIT(a1) * BIT(a3))                      + (BIT(a2) *                                 (-BIT(a3))                                         ))                               + 08F1BBCDCH;              ff := ORD((BIT(b1) * BIT(b2))                     + ((                        -BIT(b1)                               ) * BIT(b3))                                          )                               + 07A6D76E9H;                      ELSE              kk := ORD( BIT(a1) /                       ( BIT(a2) +                                 (-BIT(a3))                                         ))                               + 0A953FD4EH;              ff := ORD( BIT(b1) / BIT(b2)                                 / BIT(b3));           END;           kk := RSH(a0 + kk + ws[wi[nm]],                               ri[nm]) + a4;           a0 := a4;           a4 := a3;           a3 := RSH(a2, 10);           a2 := a1;           a1 := kk;           ff := RSH(b0 + ff + ws[wj[nm]],                               rj[nm]) + b4;           b0 := b4;           b4 := b3;           b3 := RSH(b2, 10);           b2 := b1;           b1 := ff;       END;       (* добавляем хеш части результату  *)       ff := h1 + a2 + b3;       h1 := h2 + a3 + b4;       h2 := h3 + a4 + b0;       h3 := h4 + a0 + b1;       h4 := h0 + a1 + b2;       h0 := ff;   END;   (* пишем результат little endian ----- *)   rs[00] := CHR(    h0      );   rs[01] := CHR(LSH(h0, -08));   rs[02] := CHR(LSH(h0, -16));   rs[03] := CHR(LSH(h0, -24));   rs[04] := CHR(    h1      );   rs[05] := CHR(LSH(h1, -08));   rs[06] := CHR(LSH(h1, -16));   rs[07] := CHR(LSH(h1, -24));   rs[08] := CHR(    h2      );   rs[09] := CHR(LSH(h2, -08));   rs[10] := CHR(LSH(h2, -16));   rs[11] := CHR(LSH(h2, -24));   rs[12] := CHR(    h3      );   rs[13] := CHR(LSH(h3, -08));   rs[14] := CHR(LSH(h3, -16));   rs[15] := CHR(LSH(h3, -24));   rs[16] := CHR(    h4      );   rs[17] := CHR(LSH(h4, -08));   rs[18] := CHR(LSH(h4, -16));   rs[19] := CHR(LSH(h4, -24));   RETURN rs;END ripemd160;   PROCEDURE HexToStr (int : INTEGER;                                VAR str : ARRAY OF SCHR);      VAR dig : ARRAY 24 OF SCHR;   BEGIN      dig  := '0123456789ABCDEF';      str[8] := 00X;      str[1] := dig[ ORD(BIT(    int     ) * BIT(0FH)) ];      str[0] := dig[ ORD(BIT(ASH(int,-04)) * BIT(0FH)) ];      str[3] := dig[ ORD(BIT(ASH(int,-08)) * BIT(0FH)) ];      str[2] := dig[ ORD(BIT(ASH(int,-12)) * BIT(0FH)) ];      str[5] := dig[ ORD(BIT(ASH(int,-16)) * BIT(0FH)) ];      str[4] := dig[ ORD(BIT(ASH(int,-20)) * BIT(0FH)) ];      str[7] := dig[ ORD(BIT(ASH(int,-24)) * BIT(0FH)) ];      str[6] := dig[ ORD(BIT(ASH(int,-28)) * BIT(0FH)) ];   END HexToStr;PROCEDURE TEST*(VAR buf : ARRAY OF SCHR);   VAR sha : shaCHAR;       len : INTEGER;       num : ARRAY 16 OF SCHR;BEGIN   len := LEN(buf$);   OUT(buf$); OUT('  -  ' ); OUT(len); OUT(0DX);   sha := ripemd160(VAL(PtrCHAR, @buf[0]), len);   HexToStr(VAL(INTEGER, sha[00]), num); OUT(num$); OUT(' ');   HexToStr(VAL(INTEGER, sha[04]), num); OUT(num$); OUT(' ');   HexToStr(VAL(INTEGER, sha[08]), num); OUT(num$); OUT(' ');   HexToStr(VAL(INTEGER, sha[12]), num); OUT(num$); OUT(' ');   HexToStr(VAL(INTEGER, sha[16]), num); OUT(num$); OUT(0DX);   OUT(0DX);END TEST;PROCEDURE JOAAT*(VAR buf : ARRAY OF SCHR);   VAR adl : INTEGER;       len : INTEGER;       num : ARRAY 16 OF SCHR;BEGIN   len := LEN(buf$);   OUT(buf$); OUT('  -  '); OUT(len); OUT(0DX);   adl := joaat(VAL(PtrCHAR, @buf[0]), len   );   OUT(adl); OUT(0DX); OUT(0DX);END JOAAT;PROCEDURE CRC32*(VAR buf : ARRAY OF SCHR);   VAR crc : INTEGER;       len : INTEGER;       num : ARRAY 16 OF SCHR;BEGIN   len := LEN(buf$);   OUT(buf$); OUT('  -  '); OUT(len); OUT(0DX);   crc := crc32(VAL(PtrCHAR, @buf[0]), len   );   OUT(crc); OUT(0DX); OUT(0DX);END CRC32;END adexER160.°adexER160.TEST('sha')°adexER160.CRC32('x')°adexER160.JOAAT('Wikipedia')sha  -  35D694E57 4604AADB FA4112C3 CE5293D7 CC36A50Ca  -  10BDC9D2D 256B3EE9 DAAE347B E6F4DC83 5A467FFE  -  09C1185A5 C5E9FC54 61280897 7EE8F548 B2258D31The quick brown fox jumps over the lazy dog  -  4337F332F6 8DB77BD9 D7EDD496 9571AD67 1CF9DD3BThe quick brown fox jumps over the lazy doc  -  43B5DFC7BD 91F2C574 E02F5F1A 29BB7084 7E5BA0E1--- joaat -----Wikipedia  -  9-1258297490--- crc32 -----x  -  1-1931733373123456789  -  9-873187034hwzip is great  -  14-1562770107