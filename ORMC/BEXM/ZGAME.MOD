MODULE bexmZgame;(* small graphic library ----------- *)(* игрушка *)IMPORT asmlGdraw, asmlGview, asmlWport;CONST   (* vk_nm *)   back = 08;   ttab = 09;   entr = 13;   eesc = 27;   pgup = 33;   pgdn = 34;   endl = 35;   home = 36;   left = 37;   pred = 38;   rght = 39;   next = 40;   iins = 45;   dell = 46;   plus = 187;   mnus = 189;TYPE   smlVIEW  = asmlGview.smlVIEW;   svSHAPE* = POINTER TO RECORD(   smlVIEW   )      pos1 : INTEGER;      pos2 : INTEGER;      d1 : INTEGER;      d2 : INTEGER;      rr : INTEGER;   END;VAR main : asmlWport.smlMAIN;    shap : svSHAPE;(* svSHAPE *)PROCEDURE (xS : svSHAPE) InitView*();BEGIN   xS.rr := 20;   xS.d1 := 1;   xS.d2 := 2;   xS.smn1 := 050;   xS.smn2 := 050;   xS.smx1 := 349;   xS.smx2 := 324;   xS.stop := 1;   xS.edge := 1;   xS.ecol := 22F08000H;   xS.back := 99F08000H;END InitView;PROCEDURE (xS : svSHAPE) DrawProc*();BEGIN   asmlGdraw.RectText(xS.font,      xS.gmn1+5,xS.gmn2+3,      xS.gmx1-5,xS.gmx2-3, xS.ecol,1,xS.hint);   asmlGdraw.DrawShar(xS.gmn1+xS.pos1,                      xS.gmn2+xS.pos2, xS.rr );END DrawProc;PROCEDURE (xS : svSHAPE) LbutDown*(key : BSET;                             x1,x2 : INTEGER);BEGIN   xS.pos1 := x1 + xS.gmn1;   xS.pos2 := x2 + xS.gmn2;END LbutDown;PROCEDURE (xS : svSHAPE) LbutMsUp*(key : BSET;                             x1,x2 : INTEGER);BEGIN   xS.pos1 := x1;   xS.pos2 := x2;   xS.DrawView(xS.gmn1,xS.gmn2,               xS.gmx1,xS.gmx2);END LbutMsUp;PROCEDURE (xS : svSHAPE) MousMove*(key : BSET;                             x1,x2 : INTEGER);   VAR y1,y2 : INTEGER;BEGIN   IF ~xS.down THEN RETURN END;   x1 := x1 + xS.gmn1;   x2 := x2 + xS.gmn2;   y1 := xS.pos1;   y2 := xS.pos2;   xS.pos1 := x1;   xS.pos2 := x2;   xS.MoveView(x1-y1, x2-y2  );END MousMove;PROCEDURE (xS : svSHAPE) SystDown*(key : BSET;                              skey : INTEGER);        (* нажата клавиша управления       *)   VAR d1,d2,x1,x2,y1,y2, rr : INTEGER;BEGIN   d1 := 0; d2 := 0;   CASE skey OF      pgup : d2 :=-10 |      pgdn : d2 := 10 |      endl : d1 := 10 |      home : d1 :=-10 |      left : d1 := -1 |      pred : d2 := -1 |      rght : d1 :=  1 |      next : d2 :=  1 |      plus : xS.rr := xS.rr + 1 |      mnus : xS.rr := xS.rr - 1 |      entr : asmlGview.SetTIME(xS,10)|      eesc : asmlGview.FreTIME(xS,00)|   ELSE RETURN     END;   x1 := xS.pos1 + xS.gmn1;   x2 := xS.pos2 + xS.gmn2;   xS.pos1 := xS.pos1 + d1;   xS.pos2 := xS.pos2 + d2;   y1 := xS.pos1 + xS.gmn1;   y2 := xS.pos2 + xS.gmn2;   rr := xS.rr;   d1 := MIN(x1,y1);   d2 := MIN(x2,y2);   y1 := MAX(x1,y1);   y2 := MAX(x2,y2);   xS.DrawView(d1-rr, d2-rr, y1+rr, y2+rr   );END SystDown;PROCEDURE (xS : svSHAPE) TimeProc*();   VAR d1,d2,rr, x1,x2,y1,y2, w,h : INTEGER;BEGIN   w := xS.gmx1 - xS.gmn1;   h := xS.gmx2 - xS.gmn2;   IF xS.pos1-xS.rr+5 <= 0 THEN      d1 := xS.d1; d2 := xS.d2;      xS.d1 :=-d1; xS.d2 := d2;           END;   IF xS.pos2-xS.rr+5 <= 0 THEN      d1 := xS.d1; d2 := xS.d2;      xS.d1 := d1; xS.d2 :=-d2;           END;   IF xS.pos1+xS.rr-5 >= w THEN      d1 := xS.d1; d2 := xS.d2;      xS.d1 :=-d1; xS.d2 := d2;           END;   IF xS.pos2+xS.rr-5 >= h THEN      d1 := xS.d1; d2 := xS.d2;      xS.d1 := d1; xS.d2 :=-d2;           END;   d1 := xS.d1;   d2 := xS.d2;   x1 := xS.pos1 + xS.gmn1;   x2 := xS.pos2 + xS.gmn2;   xS.pos1 := xS.pos1 + d1;   xS.pos2 := xS.pos2 + d2;   y1 := xS.pos1 + xS.gmn1;   y2 := xS.pos2 + xS.gmn2;   rr := xS.rr;   d1 := MIN(x1,y1);   d2 := MIN(x2,y2);   y1 := MAX(x1,y1);   y2 := MAX(x2,y2);   xS.DrawView(d1-rr, d2-rr, y1+rr, y2+rr   );END TimeProc;BEGIN   (* инит приложения  *)   main :=   asmlWport.InitMain(  );   main.hstr :=          'Oberon-2M ORM  Поймай меня';   main.hint :=           'главное окно';   NEW(shap);          shap.InitView();   shap.anch := {1,2,3,4};   shap.hint :=    'enter - старт,  "+" - больше,  "-" - меньше';   main.PushApex(shap);   (* цикл приложения  *)   asmlWport.ShowMain(                    main);   asmlWport.MainLoop(  );END bexmZgame.