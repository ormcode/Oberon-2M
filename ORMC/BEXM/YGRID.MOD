MODULE bexmYgrid;(* пример linux приложения *)IMPORT asmlGfont,       asmlYport, asmlSgrid;VAR main : asmlYport.smlMAIN;    grid : asmlSgrid.svSGRID;BEGIN   (* инит приложения  *)   main :=   asmlYport.InitMain(  );   main.hstr :=           'Oberon2M ORM';   main.hint :=           'главное окно';   main.font := asmlGfont.get_FONT(             'yfont.ttf', 13, { });   NEW(grid);          grid.InitView();   grid.anch := {1,2,3,4};   grid.hint :=         'Пример таблицы';   grid.crow := 96;   grid.ckol := 04;   grid.kols[00].w := 54 ;   grid.kols[01].w := 64 ;   grid.kols[02].w := 44 ;   grid.kols[03].w := 74 ;   grid.kols[00].i := 0  ;   grid.kols[01].i := 1  ;   grid.kols[02].i := 2  ;   grid.kols[03].i := 3  ;   grid.kols[00].t := 'H01';   grid.kols[01].t := 'H02';   grid.kols[02].t := 'H03';   grid.kols[03].t := 'H04';   main.PushApex(grid);   (* цикл приложения  *)   asmlYport.ShowMain(                    main);   asmlYport.MainLoop(  );END bexmYgrid.