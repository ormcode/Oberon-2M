MODULE bexmSsped;(* пример linux приложени€ *)IMPORT asmlXlibc, asmlGfont,       asmlXporc,       asmlGview, asmlSview,       asmlSutil, asmlTedit,       asmlTmemo, asmlTdman;TYPE PMATRIX = POINTER TO ARRAY OF ARRAY OF INTEGER;VAR main : asmlXporc.smlMAIN;    edit : asmlTedit.svTEDIT;    cent : asmlTedit.svTEDIT;    righ : asmlTedit.svTEDIT;    wedt : asmlTedit.svTEDIT;    ebut : asmlSview.svTBUTT;    cbut : asmlSview.svTBUTT;    rbut : asmlSview.svTBUTT;    wbut : asmlSview.svTBUTT;    memo : asmlTmemo.svTMEMO;    info : asmlSview.svTBUTT;    PROCEDURE StrToInt(VAR str : ARRAY OF SCHR) : INTEGER;       VAR i, n : INTEGER;    BEGIN       i := 0; n := 0;       WHILE str[i] # 0X DO             n := n * 10 + ORD(str[i]) - 48; INC(i)   END;       RETURN n;   END StrToInt;   PROCEDURE GetPerformanceCount(    ) : INTEGER;      VAR tim : asmlXlibc.timeval; cnt : LONGINT;   BEGIN      asmlXlibc.gettimeofday(tim, 0  );      cnt := tim.tv_sec * 1000000 + tim.tv_usec ;                       RETURN VAL(INTEGER, cnt );   END GetPerformanceCount;   PROCEDURE fibonachi(n : INTEGER   ) : INTEGER;   BEGIN      IF n > 2 THEN      RETURN fibonachi(n-1) + fibonachi(n-2) END;      RETURN 1   END fibonachi;   PROCEDURE is_primes(n : INTEGER   ) : INTEGER;      VAR i,j,k : INTEGER; p : LONGINT;   BEGIN      k := 2;      FOR i := 3 TO n DO      p := INT( SQR(i) ); j := 2;      WHILE (i MOD j #0) & (j < p) DO INC(j) END;      k := k + ORD(j >= p);                  END;      RETURN k   END is_primes;   PROCEDURE mulmatrix(n : INTEGER; A,B,C : PMATRIX);      VAR i,j,k,res : INTEGER;   BEGIN      FOR i := 0 TO n-1 DO      FOR j := 0 TO n-1 DO          res := 0;      FOR k := 0 TO n-1 DO          res := res + A[i,k] * B[k,j];      END;          C[i,j] := res;      END;      END;   END mulmatrix;   PROCEDURE while(n : INTEGER) : INTEGER;      VAR i,t : INTEGER;   BEGIN      t := GetPerformanceCount(   ) - 0;      i := 0;      WHILE i < n DO INC(i)         END;      t := GetPerformanceCount(   ) - t;      RETURN t   END while;   PROCEDURE repet(n : INTEGER) : INTEGER;      VAR i,t : INTEGER;   BEGIN      t := GetPerformanceCount(   ) - 0;      i := 0;      REPEAT INC(i) UNTIL i = n;      t := GetPerformanceCount(   ) - t;      RETURN t   END repet;   PROCEDURE forto(n : INTEGER) : INTEGER;      VAR i,t : INTEGER;   BEGIN      t := GetPerformanceCount(   ) - 0;      FOR i := 0 TO n DO            END;      t := GetPerformanceCount(   ) - t;      RETURN t   END forto;   PROCEDURE fordt(n : INTEGER) : INTEGER;      VAR i,t : INTEGER;   BEGIN      t := GetPerformanceCount(   ) - 0;      FOR i := n DT 0 DO            END;      t := GetPerformanceCount(   ) - t;      RETURN t   END fordt;      PROCEDURE cal;      BEGIN      END cal;   PROCEDURE prcal(n : INTEGER) : INTEGER;      VAR i,t : INTEGER;   BEGIN      t := GetPerformanceCount(   ) - 0;      FOR i := 0 TO n DO cal        END;      t := GetPerformanceCount(   ) - t;      RETURN t   END prcal;   PROCEDURE Ebut;      VAR n,t : INTEGER;          fib : ARRAY 20 OF SCHR;          tic : ARRAY 20 OF SCHR;   BEGIN      n := StrToInt(edit.text );      t := GetPerformanceCount(   ) - 0;      n := fibonachi(n);      t := GetPerformanceCount(   ) - t;      asmlXporc.IntToStr(n, fib);      asmlXporc.IntToStr(t, tic);      memo.PastText(ebut.text$  + ' дл€ '             + edit.text$ + ' = ' + fib$               + ', врем€ ' + tic$ + 0DX);      memo.DrawView(memo.gmn1, memo.gmn2,                    memo.gmx1, memo.gmx2);   END Ebut;   PROCEDURE Cbut;      VAR n,t : INTEGER;          fib : ARRAY 20 OF SCHR;          tic : ARRAY 20 OF SCHR;   BEGIN      n := StrToInt(cent.text );      t := GetPerformanceCount(   ) - 0;      n := is_primes(n);      t := GetPerformanceCount(   ) - t;      asmlXporc.IntToStr(n, fib);      asmlXporc.IntToStr(t, tic);      memo.PastText(cbut.text$  + ' дл€ '             + cent.text$ + ' = ' + fib$               + ', врем€ ' + tic$ + 0DX);      memo.DrawView(memo.gmn1, memo.gmn2,                    memo.gmx1, memo.gmx2);   END Cbut;   PROCEDURE Rbut;      VAR A,B,C : PMATRIX;      VAR n,t : INTEGER;          tic : ARRAY 20 OF SCHR;   BEGIN      n := StrToInt(righ.text );      NEW(A, n,n);      NEW(B, n,n);      NEW(C, n,n);      t := GetPerformanceCount(   ) - 0;      mulmatrix(n, A,B,C);      t := GetPerformanceCount(   ) - t;      FRE(A);      FRE(B);      FRE(C);      asmlXporc.IntToStr(t, tic);      memo.PastText(rbut.text$  + ' '         + righ.text$ + 'x' + righ.text$               + ', врем€ ' + tic$ + 0DX);      memo.DrawView(memo.gmn1, memo.gmn2,                    memo.gmx1, memo.gmx2);   END Rbut;   PROCEDURE Wbut;      VAR n,t,d,w,r,c  : INTEGER;          tic : ARRAY 20 OF SCHR;   BEGIN      n := StrToInt(wedt.text );      w := while(n);      r := repet(n);      t := forto(n);      d := fordt(n);      c := prcal(n);      asmlXporc.IntToStr(w, tic);      memo.PastText('while '+ wedt.text$                + ', врем€ ' + tic$ + 0DX);      asmlXporc.IntToStr(r, tic);      memo.PastText('repeat '+wedt.text$                + ', врем€ ' + tic$ + 0DX);      asmlXporc.IntToStr(t, tic);      memo.PastText('for to '+wedt.text$                + ', врем€ ' + tic$ + 0DX);      asmlXporc.IntToStr(d, tic);      memo.PastText('for dt '+wedt.text$                + ', врем€ ' + tic$ + 0DX);      asmlXporc.IntToStr(c, tic);      memo.PastText('pr cal '+wedt.text$                + ', врем€ ' + tic$ + 0DX);      memo.DrawView(memo.gmn1, memo.gmn2,                    memo.gmx1, memo.gmx2);   END Wbut;   PROCEDURE get_prop(             );   BEGIN      asmlTdman.LogoProg(memo,                      10,10,250,140);      asmlGview.Beep;   END get_prop;BEGIN   (* инит clipboard   *)   asmlSutil.clpproc :=       asmlXporc.clipproc;   (* инит приложени€  *)   main :=   asmlXporc.InitMain(  );   main.edge := 0;   main.head := 0;   main.hstr := 'Oberon-2M ORM - тест скорости';   main.font := asmlGfont.get_FONT(             'xfont.ttf', 13, { });   NEW(edit);   edit.InitSize(030,030 ,                 100,053);   edit.anch := {1,3    };   edit.fdig := 1;   edit.text := '30';   NEW(cent);   cent.InitSize(030,060 ,                 100,083);   cent.anch := {1,3    };   cent.fdig := 1;   cent.hint :=               'ѕример 1';   cent.text := '10001';   NEW(righ);   righ.InitSize(030,090 ,                 100,113);   righ.anch := {1,3    };   righ.fdig := 1;   righ.text := '100';   NEW(wedt);   wedt.InitSize(030,120 ,                 100,143);   wedt.anch := {1,3    };   wedt.fdig := 1;   wedt.text := '1000000';   main.PushLast(edit);   main.PushLast(cent);   main.PushLast(righ);   main.PushLast(wedt);   NEW(ebut);   ebut.InitSize(105, 30 ,                 280, 53);   ebut.anch := {3      };   ebut.text := '„исло фибоначи';   ebut.back := 00EAFAE8H;   ebut.clic := Ebut  ;   NEW(cbut);   cbut.InitSize(105, 60 ,                 280, 83);   cbut.anch := {3      };   cbut.text := 'ѕростые числа';   cbut.back := 00EAFAE8H;   cbut.clic := Cbut  ;   NEW(rbut);   rbut.InitSize(105,090 ,                 280,113);   rbut.anch := {3      };   rbut.text := 'ѕеремножение матриц';   rbut.back := 00EAFAE8H;   rbut.clic := Rbut  ;   NEW(wbut);   wbut.InitSize(105,120 ,                 280,143);   wbut.anch := {3      };   wbut.text := '–азные циклы';   wbut.back := 00EAFAE8H;   wbut.clic := Wbut  ;   main.PushLast(ebut);   main.PushLast(cbut);   main.PushLast(rbut);   main.PushLast(wbut);   NEW(info);   info.InitSize(290,316 ,                 340,339);   info.anch := {3,4    };   info.text := 'Info';   info.back := 00EAFAE8H;   info.clic := get_prop ;   info.hint :=         'тест float f64';   main.PushLast(info);   NEW(memo);   memo.InitSize(030,160 ,                 280,339);   memo.anch := {1,2,3,4};   memo.vert := asmlSview.v_scroll(memo);   main.PushLast(memo);   (* цикл приложени€  *)   asmlXporc.ShowMain(                    main);   asmlXporc.MainLoop(  );END bexmSsped.