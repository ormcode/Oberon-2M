MODULE aormMAY;IMPORT aormMAP, aormPtrap, FL := asmlVfile;VAR i,j : INTEGER;BEGIN   aormMAP._puts('begin module aormMAX');CLOSE   aormPtrap.settrap := FL.settrap; (* --------------------  *)   aormPtrap.fretrap := FL.fretrap; (* --------------------  *)   IF aormPtrap.InitTrap( 0 ) THEN   aormMAP._puts('     begin trap');   i  := 10;   j  := 0;   i := i DIV j;   EI aormPtrap.InfoTrap( 0 ) THEN   aormMAP._puts('      exception')  END;   IF aormPtrap.ExitTrap( 0 ) THEN   END;   aormMAP._puts('close module aormMAX');END aormMAY.aormPtrapaormMckrnasmlVlibfasmlVlibsasmlVfileaormMAPaormMAY°aormMac64.linker( 'd:\vtrap.app = asmlVlibc asmlVlibf asmlVfile                                    aormPtrap aormMAP   aormMAY' )