MODULE aormLAX;IMPORT aormLAP;VAR j : INTEGER;   rec : POINTER TO RECORD         ptr : POINTER TO ARRAY 10 OF INTEGER;         pt2 : POINTER TO ARRAY OF INTEGER;         END;BEGINrec := SYS(j);IF j = 1 THENj := aormLAP.MessageBoxA(0,'SYS = 1','XAP',{});END;j := aormLAP.MessageBoxA(0,'begin ÏÓ‰ÛÎ¸ aormXAP','XAP',{});j := 5555555; OUT(j); OUT(0DX);NEW(rec);NEW(rec.ptr);rec.ptr[9] := 9;OUT(rec.ptr[0]); OUT(0DX);OUT(rec.ptr[9]); OUT(0DX);FRE(rec.ptr);NEW(rec.pt2,100);rec.pt2[99] := 99;OUT(rec.pt2[0]); OUT(0DX);OUT(rec.pt2[99]); OUT(0DX);FRE(rec.pt2);FRE(rec);CLOSEj := aormLAP.MessageBoxA(0,'close ÏÓ‰ÛÎ¸ aormXAP','XAP',{});END aormLAX.aormLpkrnaormLAPaormLAX∞aormLpe32.linker('d:\z_lax.exe = aormLAP aormLAX' )∞aormLpr32.linker('d:\z_lax.exe = aormLAP aormLAX' )