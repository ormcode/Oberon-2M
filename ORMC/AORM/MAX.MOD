MODULE aormMAX;IMPORT aormMAP;VAR j : INTEGER;   rec : POINTER TO RECORD         ptr : POINTER TO ARRAY 10 OF INTEGER;         pt2 : POINTER TO ARRAY OF INTEGER;         END;BEGIN   aormMAP._puts('begin module aormMAX');j := 5555555; OUT(j); OUT(0DX);NEW(rec);NEW(rec.ptr);rec.ptr[9] := 9;OUT(rec.ptr[0]); OUT(0DX);OUT(rec.ptr[9]); OUT(0DX);FRE(rec.ptr);NEW(rec.pt2,100);rec.pt2[99] := 99;OUT(rec.pt2[0]); OUT(0DX);OUT(rec.pt2[99]); OUT(0DX);FRE(rec.pt2);FRE(rec);CLOSE   aormMAP._puts('close module aormMAX');END aormMAX.aormMckrnaormMAPaormMAX°aormMac64.linker('d:\v_max.app = aormMAP aormMAX' )°aormMar64.linker('d:\v_max.app = aormMAP aormMAX' )