MODULE aormEAY;IMPORT aormEAP, aormPtrap, FL := asmlXfile;VAR i,j : INTEGER;BEGIN   aormEAP.puts('begin module aormEAP');CLOSE   aormPtrap.settrap := FL.settrap; (* --------------------  *)   aormPtrap.fretrap := FL.fretrap; (* --------------------  *)   IF aormPtrap.InitTrap( 0 ) THEN   aormEAP.puts('     begin trap');   i  := 10;   j  := 0;   i := i DIV j;   EI aormPtrap.InfoTrap( 0 ) THEN   aormEAP.puts('      exception')  END;   IF aormPtrap.ExitTrap( 0 ) THEN  END;   aormEAP.puts('close module aormEAP');END aormEAY.aormPtrapaormElkrnasmlXlibfasmlXlibsasmlXfileaormEAPaormEAY°aormElf64.linker( 'd:\xtrap.elf = asmlXlibc asmlXlibd asmlXlibf                                    asmlXfile                                    aormPtrap aormEAP   aormEAY' )