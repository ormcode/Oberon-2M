DEF_MODULE asmlGdraw;     (* MT, 01.09.2016 *)(* small graphic library ------------------ *)(* графические функции - нижнего уровеня -- *)(*    *-----------> x1    *)(*    |                   *)(*    |                   *)(*    v - ось x2          *)(* системные функции *)PROCEDURE initBMAP*(d1,d2       : INTEGER);   (* инициализация плоскости рисования *)PROCEDURE setsBMAP*(image       : ADDRESS ;                    d1,d2       : INTEGER);   (* инициализация плоскости рисования *)PROCEDURE clipBMAP*(x1,x2,y1,y2 : INTEGER);   (* отсекаем область рисования        *)(* шрифтовые функции *)PROCEDURE DrawText*(fnt : smlFONT; x1,x2,y1,y2 : INTEGER ;                    col : INTEGER; VAR txt:ARRAY OF SCHR);PROCEDURE RectText*(fnt : smlFONT; x1,x2,y1,y2 : INTEGER ;                    c,a : INTEGER; VAR txt:ARRAY OF SCHR);(* функции рисования *)PROCEDURE DrawPlot*(x1,x2       : INTEGER; col : INTEGER);PROCEDURE HorzLine*(x1,x2,y1    : INTEGER; col : INTEGER);PROCEDURE VertLine*(x1,x2,   y2 : INTEGER; col : INTEGER);PROCEDURE DrawLine*(x1,x2,y1,y2 : INTEGER; col : INTEGER);PROCEDURE DrawRect*(x1,x2,y1,y2 : INTEGER; col : INTEGER);PROCEDURE LoweRect*(x1,x2,y1,y2 : INTEGER; col : INTEGER);PROCEDURE RaisRect*(x1,x2,y1,y2 : INTEGER; col : INTEGER);PROCEDURE FillRect*(x1,x2,y1,y2 : INTEGER; col : INTEGER);PROCEDURE DrawDisk*(x1,x2,y1,y2 : INTEGER; col : INTEGER);PROCEDURE FillDisk*(x1,x2,y1,y2 : INTEGER; col : INTEGER);PROCEDURE DrawOval*(x1,x2,y1,y2 : INTEGER; col : INTEGER);(* функции спецэфект *)PROCEDURE DrawShar*(p1,p2, rr   : INTEGER);PROCEDURE DrawLamp*(g1,g2,g3, p1,p2,  gcol : INTEGER);PROCEDURE Gradient*(x1,x2,y1,y2, col1,col2 : INTEGER);PROCEDURE Hradient*(x1,x2,y1,y2, col1,col2 : INTEGER);PROCEDURE Circular*(x1,x2,y1,y2, col1,col2 : INTEGER);PROCEDURE Hircular*(x1,x2,y1,y2, col1,col2 : INTEGER);PROCEDURE Vradient*(x1,x2,y1,y2, col1,col2 : INTEGER);PROCEDURE Dradient*(                 x1,x2,y1,y2,dh, col1,col2 : INTEGER);PROCEDURE BlurRect*(x1,x2,y1,y2, col1,col2 : INTEGER);(* одноцветн.рисунки *)PROCEDURE PapeIcon*(x1,x2,d1,d2 : INTEGER;                                icon : ARRAY OF SCHR);   (* бумажный знак - фон снизу, переводной знак   *)   (* водяной знак - фон сверху, подсветка снизу   *)PROCEDURE DrawIcon*(x1,x2,d1,d2, cl : INTEGER;                                      icon : ADDRESS);END asmlGdraw.