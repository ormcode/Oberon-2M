DEF_MODULE asmlGfont;     (* MT, 01.09.2016 *)(* small graphic library ------------------ *)(* определение шрифтов  - метрика шрифта    *)(*   --------------------------             *]                             ^                             |                             |                             |                             |           **  *******       |           ** *********      |           ***        **     |     ascender           **          **    |           **          **    |           **          **    |           ***        **     |           ** *********      v     ----  **  ******* ----------- baseline           **                ^           **                |           **                |    descender           **                |           **                |                             v[*   --------------------------             *)TYPE   smlFONT* = POINTER TO RECORD()                 name* : smlTEXT;                 size* : INTEGER;                 fpar* : BSET;                 (* метрика   *)                 maxw* : INTEGER;                 maxh* : INTEGER;                 ascn* : INTEGER;                 desc* : INTEGER;                 (* растр     *)                 mapw* : INTEGER;                 maph* : INTEGER;                 mapF* : mapFONT;                 (* ширины    *)                 minW* : ARRAY                     256 OF WORD;              END;VAR (* процедура растеризации шрифта *)    setFONT*: PROCEDURE (sF : smlFONT);PROCEDURE get_FONT*(name : ARRAY OF SCHR;                    size : INTEGER;                    fpar : BSET   ) : smlFONT;(* smlFONT *)PROCEDURE (sF : smlFONT) hght*(   ) : INTEGER;PROCEDURE (sF : smlFONT) wsch*(                        chr : SCHR) : INTEGER;PROCEDURE (sF : smlFONT) wdth*(           VAR txt : ARRAY OF SCHR) : INTEGER;PROCEDURE (sF : smlFONT) wchr*( pos : INTEGER;           VAR txt : ARRAY OF SCHR) : INTEGER;PROCEDURE (sF : smlFONT) offs*( b,e : INTEGER;           VAR txt : ARRAY OF SCHR) : INTEGER;PROCEDURE (sF : smlFONT) just*( b,e : INTEGER;                                p,w : INTEGER;           VAR txt : ARRAY OF SCHR) : INTEGER;END asmlGfont.