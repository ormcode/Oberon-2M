DEF_MODULE asmlGview;     (* MT, 01.09.2016 *)(* прототип объекта окно  *)(*    *-----------> x1    *)(*    |                   *)(*    |                   *)(*    v - ось x2          *)(* Важно: все координаты считаются абсолютн *)(*        ыми, отсчет координат идет от лев *)(*        ого верхнего угла - главного окна *)(*        приложения                        *)TYPE   LISTENE* = PROCEDURE(sml : smlVIEW   ;                        par : INTEGER ) ;   smlPROC* = PROCEDURE(sml : smlVIEW   ;                        par : INTEGER  );   smlTEXT  = ARRAY 064 OF SCHR;   smlFONT  = asmlGfont.smlFONT;   smlVIEW* = POINTER TO RECORD()                 (* контексты  *)                 mwnd* : ADDRESS;                 mhdc* : ADDRESS;                 (* z-уровень  *)                 pred- : smlVIEW;                 next- : smlVIEW;                 (* контейнер  *)                 vdir- : smlVIEW;                 (* вложенные  *)                 apex- : smlVIEW;                 (* темп окно  *)                 vsys* : smlVIEW;                 view* : smlVIEW;                 (* слушатель  *)                 proc* : LISTENE;                 (* кординаты  *)                 gmn1* : INTEGER;                 gmn2* : INTEGER;                 gmx1* : INTEGER;                 gmx2* : INTEGER;                 (* локальные  *)                 smn1* : INTEGER;                 smn2* : INTEGER;                 smx1* : INTEGER;                 smx2* : INTEGER;                 (* якорь      *)                 anch* : BSET   ;                 (* толщ.края  *)                 edge* : INTEGER;                 head* : INTEGER;                 foot* : INTEGER;                 (* цвет фона  *)                 back* : INTEGER;                 ecol* : INTEGER;                 fcol* : INTEGER;                 (* видимость  *)                 hide* : BOOLEAN;                 sell* : BOOLEAN;                 down* : BOOLEAN;                 fkey* : BOOLEAN;                 (* ms cursor  *)                 curs* : INTEGER;                 (* order tab  *)                 stop* : INTEGER;                 (* метка tag  *)                 stag* : INTEGER;                 temp* : INTEGER;                 (* show hint  *)                 font* : smlFONT;                 hint* : smlTEXT;              END;VAR SetTIME* : smlPROC;    FreTIME* : smlPROC;    Lock*  : PROCEDURE;    Undo*  : PROCEDURE;    Beep*  : PROCEDURE;    Peek*  : PROCEDURE;    Stop*  : PROCEDURE;    Loop*  : PROCEDURE;VAR WinPORT*           : PROCEDURE(hdc : ADDRESS;                       x1,x2,y1,y2 : INTEGER);(* smlVIEW - виртуальные методы  *)PROCEDURE (sV : smlVIEW) InitView*(         );PROCEDURE (sV : smlVIEW) FreeProc*(         );PROCEDURE (sV : smlVIEW) DrawEdge*(         );PROCEDURE (sV : smlVIEW) DrawHead*(         );PROCEDURE (sV : smlVIEW) DrawFoot*(         );PROCEDURE (sV : smlVIEW) DrawProc*(         );PROCEDURE (sV : smlVIEW) TimeProc*(         );PROCEDURE (sV : smlVIEW) TemaProc*(                         param : INTEGER    );PROCEDURE (sV : smlVIEW) MoveProc*(                         d1,d2 : INTEGER    );PROCEDURE (sV : smlVIEW) SizeProc*(                         d1,d2 : INTEGER    );PROCEDURE (sV : smlVIEW) SendMess*(msg : BSET;                         param : INTEGER    );PROCEDURE (sV : smlVIEW) SystDown*(key : BSET;                          skey : INTEGER    );PROCEDURE (sV : smlVIEW) CharDown*(key : BSET;                          char : INTEGER    );PROCEDURE (sV : smlVIEW) RbutDown*(key : BSET;                         x1,x2 : INTEGER    );PROCEDURE (sV : smlVIEW) RbutMsUp*(key : BSET;                         x1,x2 : INTEGER    );PROCEDURE (sV : smlVIEW) RbutDbcl*(key : BSET;                         x1,x2 : INTEGER    );BEGIN                            END RbutDbcl;PROCEDURE (sV : smlVIEW) LbutDown*(key : BSET;                         x1,x2 : INTEGER    );PROCEDURE (sV : smlVIEW) LbutMsUp*(key : BSET;                         x1,x2 : INTEGER    );PROCEDURE (sV : smlVIEW) LbutDbcl*(key : BSET;                         x1,x2 : INTEGER    );PROCEDURE (sV : smlVIEW) MousMove*(key : BSET;                         x1,x2 : INTEGER    );PROCEDURE (sV : smlVIEW) MousWhel*(key : BSET;                         param : INTEGER    );PROCEDURE (sV : smlVIEW) MousHove*(key : BSET;                         param : smlVIEW    );PROCEDURE (sV : smlVIEW) MousLeav*(key : BSET;                         param : smlVIEW    );PROCEDURE (sV : smlVIEW) SetFocus*(         );PROCEDURE (sV : smlVIEW) KilFocus*(         );(* smlVIEW - процедурные методы  *)PROCEDURE (sV : smlVIEW) InitSize*(                x1,x2, y1,y2 : INTEGER);PROCEDURE (sV : smlVIEW) DrawView*(                x1,x2, y1,y2 : INTEGER);   (* процедура - рисуем только себя *)PROCEDURE (sV : smlVIEW) HideView*(   );   (* делаем окно невидимым          *)PROCEDURE (sV : smlVIEW) ShowView*(   );   (* делаем окно видимым            *)PROCEDURE (sV : smlVIEW) EnteView*(   );   (* передача фокуса ввода          *)PROCEDURE (sV : smlVIEW) SizeView*(                       d1,d2 : INTEGER);PROCEDURE (sV : smlVIEW) MoveView*(                       d1,d2 : INTEGER);PROCEDURE (sV : smlVIEW) PullView*(                m1,m2, d1,d2 : INTEGER);PROCEDURE (sV : smlVIEW) ExclView*(   );   (* исключить окно из списка       *)PROCEDURE (sV : smlVIEW) PutOnTop*(   );   (* поместить окно самый верх      *)PROCEDURE (sV : smlVIEW) PutOnBot*(   );   (* поместить окно самый вниз      *)PROCEDURE (sV : smlVIEW) PuttHint*(                          vw : smlVIEW);   (* вставить верх перед окном      *)PROCEDURE (sV : smlVIEW) PushPred*(                          vw : smlVIEW);   (* вставить вверх контейнера      *)PROCEDURE (sV : smlVIEW) PushNext*(                          vw : smlVIEW);   (* вставить вверх контейнера      *)PROCEDURE (sV : smlVIEW) PushApex*(                          vw : smlVIEW);   (* вставить вверх контейнера      *)PROCEDURE (sV : smlVIEW) PushLast*(                          vw : smlVIEW);   (* вставить в низ контейнера      *)PROCEDURE (sV : smlVIEW) FreeView*(   );END asmlGview.