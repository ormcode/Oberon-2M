DEF_MODULE asmlGdsvg;     (* MT, 09.09.2024 *)(* small graphic library ------------------ *)(* svg (scalable vector graphics) - формат  *)(* описания векторной графики, рисуемой из  *)(* геметрических примитивов (линий, кривых  *)(* прямоугольников, кругов и эллипсов).     *)(* основные команды последовательного рисо  *)(* вания замкнутого контура:                *)(* M x y - поместить перо в точку (x, y)    *)(* H x   - провести горизонтальную линию    *)(* V y   - провести вертикальную линию      *)(* L x y - провести произвольную линию      *)(* T x y - симметричная кривая Безье отн    *)(*         осительно предыдущей             *)(* Q x y z - квадратичная кривая Безье      *)(*           по трем точкам                 *)(* D x y z - дуга эллипса по двум каса      *)(*           тельным                        *)(* E x y z - дуга окружности через три      *)(*           точки                          *)(* Z - замкнуть контур                      *)(* алгоритм: секущая прямая пересекает зам  *)(*      кнутую линию четное количество раз  *)(* исключен: секущая прямая содержит пряой  *)(*      участок линии, такой участок счита  *)(*      ем, как одну составную точку        *)(*         - секущая прямая проходит через  *)(*      вершину локального минимума или ма  *)(*      ксимума, такая точка учитывается в  *)(*      структуре пересечений дважды        *)(* особенно: пересечения (вершины), заданы  *)(*      составным числом из начала и конца  *)(*      условного горизонтального участка   *)CONST   chrA* = 'M 217 735 l -90 288 h -127 l  320'            + ' -1023 h 127 l 320 1023 h -127'                              + 'l -90 -288 Z'     + 'M 257 608 l 127 -408 h 1 l 127 408 Z';   chrB* = 'M 0 0 h 576 q 191 0 191 191 v 193'             + 'q 0 68 -64 128 q 64 58 64 127'           + 'v 193 q 0 191 -191 191 h -576 Z'              + 'M 127 127 h 449 q 64 0 64 64'              + 'v 193 q 0 64 -64 64 h -449 Z'              + 'M 127 575 h 449 q 64 0 64 64'             + 'v 193 q 0 64 -64 64 h -449 Z';   chrC* = 'M 0 191 q 0 -191 191 -191 h 385'                    + 'q 191 0 191 191 v 64'            + 'h -127 v -64 q 0 -64 -64 -64'             + 'h -385 q -64 0 -64 64 v 641'                      + 'q 0 64 64 64 h 385'               + 'q 64 0 64 -64 v -64 h 127'            + 'v 64 q 0 191 -191 191 h -385'                   + 'q -191 0 -191 -191 Z';   chrD* = 'M 0 0 h 576 q 191 0 191 191 v 641'                 + 'q 0 191 -191 191 h -576 Z'              + 'M 127 127 h 449 q 64 0 64 64'             + 'v 641 q 0 64 -64 64 h -449 Z';   chrE* = 'M 0 0 h 767 v 127 h -640 v 321'                     + 'h 576 v 127 h -576'            + 'v 321 h 640 v 127 h -767 Z';   chrM* = 'M 0 0 h 159 l 225 416 l 224 -416'               + 'h 159 v 1023 h -127 v -832'            + 'l -193 384 h -127 l -193 -384'                          + 'v 832 h -127 Z';   chrN* = 'M 0 0 h 127 l 513 448 v -448 h127'          + 'v 1023 h -127 v -448 l -513 -448'                           + 'v 896 h -127 Z';   chrO* = 'M 0 191 q 0 -191 191 -191 h 385'                   + 'q 191 0 191 191 v 641'                 + 'q 0 191 -191 191 h -385'                    + 'q -191 0 -191 -191 Z'          + 'M 127 191 q 0 -64 64 -64 h 385'                      + 'q 64 0 64 64 v 641'                    + 'q 0 64 -64 64 h -385'                      + 'q -64 0 -64 -64 Z';   chrR* = 'M 0 0 h 576 q 191 0 191 191 v 193'         + 'q 0 191 -191 191 l 191 448 h -127'         + 'l -191 -448 h -322 v 448 h -127 Z'              + 'M 127 127 h 449 q 64 0 64 64'             + 'v 193 q 0 64 -64 64 h -449 Z';   chr2* = 'M 0 191 q 0 -191 191 -191 h 385'                   + 'q 191 0 191 191 v 193'                 + 'q 0 191 -191 191 h -385'                    + 'q -64 0 -64 64 v 257'               + 'h 640 v 127 h -767 v -384'                 + 'q 0 -191 191 -191 h 385'                    + 'q 64 0 64 -64 v -193'                  + 'q 0 -64 -64 -64 h -385'           + 'q -64 0 -64 64 v 64 h -127 Z';   tire* = 'M 64 448  h 639 v 127 h -639 Z';   lamp* = 'M 192 768 q 0 -73 -89 -168'           + 'd -599 -599 248 -599 h 1'          + 'd 847 0 248 599 q -89 93 -89 168'          + 'v 176 q 0 16 -32 16'       + 'q 0 64 -96 64 h -63 q -96 0 -96 -64'                  + 'q -32 0 -32 -16 v -176 Z'          + 'M 220 736 q 0 -49 -95 -159'          + 'd -546 -546 226 -546 h 1'        + 'd 772 0 226 546 q -86 99 -95 159 Z'            + 'M 223 767 h 257 v 161 h -257 Z'       + 'M 255 960 h 193 q 0 32 -64 32 h -65'                         + 'q -64 0 -64 -32 Z'       + 'M 151 351 d 0 -200 200 -200 h 4 v 4'                     + 'q -160 40 -200 200 Z';PROCEDURE LogoType*(x1,x2,y1,y2 : INTEGER; col : INTEGER);PROCEDURE DrawCurv*(x1,x2,y1,y2 : INTEGER;                          z1,z2 : INTEGER; col : INTEGER);   (* дуга окружности по трем точкам ----------------- *)PROCEDURE DrawDuga*(x1,x2,y1,y2 : INTEGER;                          z1,z2 : INTEGER; col : INTEGER);   (* дуга окружности по двум касательным ------------ *)PROCEDURE DrawBezy*(x1,x2,y1,y2 : INTEGER;                          z1,z2 : INTEGER; col : INTEGER);(* простая растеризация без сглаживания -------------- *)(* --------------------------------------------------- *)PROCEDURE DrawPath*(x1,x2,y1,y2 : INTEGER; col : INTEGER ;                                    path : ARRAY OF SCHR);   (* растеризация и отрисовка контура глифа           *)PROCEDURE FillPath*(x1,x2,y1,y2 : INTEGER; col : INTEGER ;                                    path : ARRAY OF SCHR);   (* растеризация и заливка контура глифа             *)(* ssaa - растеризация со сглаживанием (анти-алиасинг) *)(* --------------------------------------------------- *)PROCEDURE DrawSsaa*(x1,x2,y1,y2 : INTEGER; col : INTEGER ;                                    path : ARRAY OF SCHR);   (* растеризация и отрисовка контура глифа           *)PROCEDURE FillSsaa*(x1,x2,y1,y2 : INTEGER; col : INTEGER ;                                    path : ARRAY OF SCHR);   (* растеризация и заливка контура глифа             *)END asmlGdsvg.