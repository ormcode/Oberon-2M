DEF_MODULE asmlWfile;     (* MT, 30.05.2024 *)(* small graphic library ------------------ *)(* управление файлами в windows             *)(* просмотр содержимого каталога            *)CONST   slash* = '\';(* exception trap ------------------------------------ *)PROCEDURE settrap*(proc : ADDRESS) : ADDRESS;PROCEDURE fretrap*(hand : ADDRESS) : ADDRESS;(* --------------------------------------------------- *)PROCEDURE new_map*(size : INTEGER) : ADDRESS;PROCEDURE fre_map*(addr : ADDRESS) : INTEGER;(* --------------------------------------------------- *)PROCEDURE procNEW*(size : INTEGER) : ADDRESS;PROCEDURE procFRE*(addr : ADDRESS) : INTEGER;PROCEDURE loadDLL*(name : PTRCHAR) : ADDRESS;PROCEDURE freeDLL*(hand : ADDRESS) : INTEGER;PROCEDURE procADR*(hand : ADDRESS;                   name : PTRCHAR) : ADDRESS;(* групповые файловые операции нижнего уровня -------- *)PROCEDURE CurrPath*(VAR path : ARRAY OF SCHR            );PROCEDURE CommLine*(VAR path : ARRAY OF SCHR            );PROCEDURE ListDisk*(VAR node : arrNODE  ) : INTEGER;PROCEDURE ListFile*(VAR node : arrNODE;              VAR path : ARRAY OF SCHR  ) : INTEGER;(* функции создания и удаления каталогов --- *)PROCEDURE mkdir*(     name : PTRCHAR) : BOOLEAN;PROCEDURE rmdir*(     name : PTRCHAR) : BOOLEAN;(* основные файловые операции нижнего уровня *)PROCEDURE exist*(name : PTRCHAR     ) : BOOLEAN;PROCEDURE fopen*(name : PTRCHAR     ) : THANDLE;   (* открывает существующий файл как есть   *)PROCEDURE nopen*(name : PTRCHAR     ) : THANDLE;   (* создает новый или очищает существующий *)PROCEDURE ffree*(file : THANDLE     );PROCEDURE flush*(file : THANDLE     );PROCEDURE fseek*(file : THANDLE; pos : INTEGER);PROCEDURE ftell*(file : THANDLE     ) : INTEGER;PROCEDURE fsize*(file : THANDLE     ) : INTEGER;PROCEDURE ssize*(file : THANDLE; pos : INTEGER);PROCEDURE fread*(file : THANDLE;                  buf : PTRCHAR;                  len : INTEGER     ) : INTEGER;PROCEDURE fwrit*(file : THANDLE;                  buf : PTRCHAR;                  len : INTEGER     ) : INTEGER;END asmlWfile.