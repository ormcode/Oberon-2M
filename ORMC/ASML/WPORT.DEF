DEF_MODULE asmlWport;     (* MT, 01.09.2016 *)(* small graphic library ------------------ *)(* связь с winapi - графический порт        *)(* важно: повторная регистрация класса окна *)(*        с тем же именем вызывает исключен *)(*        ие, при динамическом запуске себя *)(*        имя класса надо менять            *)   PROCEDURE IntToStr*(int : INTEGER;                                VAR str : ARRAY OF SCHR);   PROCEDURE WinToUtf*(VAR rus,                          utf : ARRAY OF SCHR) : INTEGER;      (* конвертация windows-1251 в utf-8              *)   PROCEDURE ShowINFO*(par : INTEGER;                                    inf : ARRAY OF SCHR);(* system  *)PROCEDURE InitMain*(    ) : asmlGmain.smlMAIN;   (* инициализация главного окна          *)PROCEDURE ShowForm*(mn1,mn2 : INTEGER;                    smw : asmlGmain.smlMAIN );   (* отображение всплывающего окна        *)PROCEDURE ShowMain*(smw : asmlGmain.smlMAIN );   (* отображение главного окна            *)PROCEDURE PeekMess*;   (* очистка списка сообщений             *)PROCEDURE StopLoop*;   (* stop обработки сообщений             *)PROCEDURE ProcLoop*;   (* цикл обработки сообщений             *)PROCEDURE MainLoop*;   (* цикл обработки сообщений             *)PROCEDURE PostQuit*;   (* завершение работы приложения         *)PROCEDURE Terminat*;   (* принудительное завершение работы     *)END asmlWport.